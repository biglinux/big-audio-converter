msgstr "Ouça a próxima faixa quando a atual terminar."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:41
msgid "Show the equalizer. Its settings affect exported audio."
msgstr "Mostra o equalizador. Seus ajustes alteram o áudio exportado."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:42
