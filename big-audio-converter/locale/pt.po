#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:59
msgid "The application is closing."
msgstr "O aplicativo está sendo fechado."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:63
msgid ""
"A conversion is still running. Wait for it to finish cancelling before "
"starting another."
msgstr ""
"Ainda há uma conversão em andamento. Aguarde o cancelamento terminar antes "
"de iniciar outra."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:109
msgid "Conversion cancelled."
msgstr "Conversão cancelada."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:130
msgid "The output path is invalid. Check the source filename and destination."
msgstr ""
"O caminho de saída é inválido. Confira o nome do arquivo de origem e a pasta "
"de destino."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:157
msgid "An unexpected error stopped this conversion."
msgstr "Um erro inesperado interrompeu esta conversão."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:186
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr ""
"O FFmpeg não está instalado. Instale o pacote FFmpeg e tente novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:217
msgid ""
"Fast Copy cannot apply effects, change channels or resample. Select an "
"encoding format."
msgstr ""
"A cópia sem conversão não permite efeitos nem alterações de canais ou "
"frequência de amostragem. Escolha outro formato."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:228
msgid ""
"Fast Copy preserves encoded audio packets; cut boundaries are approximate. "
"Effects are not applied."
msgstr ""
"A cópia preserva o áudio codificado; os cortes são aproximados. Os efeitos "
"não são aplicados."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:240
msgid ""
"Floating-point audio was explicitly converted to 24-bit integer PCM for "
"FLAC; this is not a bit-exact copy."
msgstr ""
"O áudio de ponto flutuante foi convertido para PCM inteiro de 24 bits para "
"salvar em FLAC, conforme autorizado. A precisão original foi reduzida."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:246
msgid ""
"Opus uses a 48 kHz playback sample clock. The source sample rate cannot be "
"represented unchanged in the output container."
msgstr ""
"O Opus usa uma frequência de reprodução de 48 kHz. A frequência original não "
"pode ser mantida sem alteração no arquivo de saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:253
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr ""
"O formato de saída exige alterar a frequência de {rate} Hz para {final_rate} "
"Hz."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:268
msgid "Positive gain may clip. Enable clipping protection or reduce the gain."
msgstr ""
"O aumento de volume pode distorcer o áudio. Ative a proteção contra "
"distorção ou reduza o ganho."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:274
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr ""
"Este formato de áudio não permite preservar todas as etiquetas ou a capa."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:281
msgid "Artwork is not preserved by this output profile."
msgstr "Este perfil de saída não preserva a capa."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:347
msgid ""
"The source changed during conversion. No output was published; add the file "
"again."
msgstr ""
"O arquivo de origem mudou durante a conversão. Nenhum resultado foi salvo; "
"adicione o arquivo novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:361
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Conversão cancelada. Nenhum arquivo incompleto foi salvo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:375
msgid ""
"The file or destination could not be accessed. Check permissions and free "
"disk space."
msgstr ""
"Não foi possível acessar o arquivo ou a pasta de destino. Confira as "
"permissões e o espaço livre."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:384
msgid "The media information or conversion settings are invalid."
msgstr ""
"As informações do áudio ou as configurações de conversão são inválidas."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:401
msgid "The encoder changed the requested sample rate. No output was published."
msgstr ""
"O codificador alterou a frequência solicitada. Nenhum resultado foi salvo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:409
msgid ""
"The encoder changed the requested channel count. No output was published."
msgstr ""
"O codificador alterou o número de canais solicitado. Nenhum resultado foi "
"salvo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:417
msgid ""
"This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV "
"or install a compatible FFmpeg package."
msgstr ""
"Esta versão do FFmpeg não preserva a precisão solicitada em FLAC. Escolha "
"WAV ou instale uma versão compatível do FFmpeg."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/converter.py:436
#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:153
msgid "Select a supported output format."
msgstr "Escolha um formato de saída compatível."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "Escolha um arquivo de áudio ou vídeo válido neste computador."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "O arquivo de origem não existe ou não é um arquivo comum."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:39
msgid "The selected audio track is invalid. Add the file again."
msgstr "A faixa de áudio selecionada é inválida. Adicione o arquivo novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "O vídeo de origem não foi encontrado. Adicione o arquivo novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:65
msgid "A segment has invalid start or end times."
msgstr "Um trecho tem início ou fim inválido."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:70
msgid "Every segment must have a finite end time after its start."
msgstr "Cada trecho precisa ter um fim válido posterior ao início."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:79
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "Um trecho ultrapassa a duração do áudio. Ajuste seu fim."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:85
msgid "A segment must contain at least one audio sample."
msgstr "Um trecho precisa conter pelo menos uma amostra de áudio."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:168
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr ""
"O FFprobe não está instalado. Instale o pacote FFmpeg e tente novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:195
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr ""
"Não foi possível ler o arquivo. Ele pode estar danificado ou ter um formato "
"incompatível."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:203
msgid "FFprobe returned invalid media information."
msgstr "O FFprobe retornou informações de áudio inválidas."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:208
msgid "FFprobe returned incomplete media information."
msgstr "O FFprobe retornou informações de áudio incompletas."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:221
msgid "This file does not contain the selected audio track."
msgstr "Este arquivo não contém a faixa de áudio selecionada."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/media.py:266
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr ""
"O codificador WAV selecionado não consegue preservar esta precisão PCM."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:153
msgid ""
"Audio preview is unavailable. Install mpv and python-mpv, then reopen the "
"application."
msgstr ""
"A reprodução está indisponível. Instale mpv e python-mpv e reabra o "
"aplicativo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:180
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr ""
"Não foi possível listar as saídas de áudio. Tente reabrir o seletor de saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:202
msgid ""
"The selected audio output was disconnected. Playback is paused. Choose an "
"output or resume using the system default."
msgstr ""
"A saída de áudio selecionada foi desconectada. A reprodução está pausada. "
"Escolha uma saída ou retome usando o padrão do sistema."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:215
msgid "This audio output is no longer available. Choose another output."
msgstr "Esta saída de áudio não está mais disponível. Escolha outra saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:227
msgid "The audio output could not be selected. Choose another output."
msgstr "Não foi possível selecionar a saída de áudio. Escolha outra saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:253
msgid "The selected audio track is unavailable. Add the file again."
msgstr ""
"A faixa de áudio selecionada está indisponível. Adicione o arquivo novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:285
msgid "The audio could not be played. Check the file and audio output device."
msgstr ""
"Não foi possível reproduzir o áudio. Confira o arquivo e o dispositivo de "
"saída de som."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:411
msgid "This audio position could not be reached."
msgstr "Não foi possível avançar até esta posição do áudio."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/player.py:460
msgid ""
"A preview effect could not be applied. Check the selected effects and "
"installed plugins."
msgstr ""
"Não foi possível aplicar um efeito na reprodução. Confira os efeitos "
"selecionados e os plugins instalados."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/probe_service.py:59
msgid ""
"Too many files are waiting for inspection. Wait for some files to finish, "
"then add more."
msgstr ""
"Há muitos arquivos aguardando análise. Aguarde alguns terminarem e depois "
"adicione mais."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/probe_service.py:80
msgid "Select a regular local media file, not a folder or device."
msgstr ""
"Escolha um arquivo de áudio ou vídeo local, em vez de uma pasta ou "
"dispositivo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/probe_service.py:100
msgid "The file changed during inspection. Add it again."
msgstr "O arquivo mudou durante a análise. Adicione-o novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/process.py:109
#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/process.py:137
msgid "The media command timed out."
msgstr "A operação de áudio excedeu o tempo limite."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/process.py:127
msgid "The media information is too large to process safely."
msgstr ""
"As informações do arquivo são grandes demais para processar com segurança."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:111
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Valor inválido para {key}."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:115
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "{key} deve estar entre {low} e {high}."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:123
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Valor de ativação inválido para {key}."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:133
msgid "The equalizer bands are invalid."
msgstr "As faixas do equalizador são inválidas."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:140
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "O equalizador precisa de dez valores válidos entre -40 e 40 dB."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:144
msgid "Select a supported noise reduction mode."
msgstr "Selecione um modo de redução de ruído compatível."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:169
msgid ""
"FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow "
"conversion to 24-bit PCM in Advanced encoding."
msgstr ""
"O FLAC não consegue preservar esta representação PCM. Escolha WAV ou "
"autorize a conversão para PCM de 24 bits nas opções avançadas."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:194
msgid "The selected bitrate is not supported by this output profile."
msgstr "A taxa de bits selecionada não é compatível com este perfil de saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:201
msgid "Select original, mono or stereo channels."
msgstr "Escolha os canais originais, mono ou estéreo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:209
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "MP3 aceita mono ou estéreo. Escolha estéreo ou outro formato."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:216
msgid "Select a valid output sample rate."
msgstr "Escolha uma frequência de amostragem válida para a saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:223
msgid "The selected codec does not support that sample rate."
msgstr "O formato selecionado não aceita essa frequência de amostragem."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:290
msgid ""
"The selected noise reduction plugin is unavailable. Install it or turn noise "
"reduction off."
msgstr ""
"O plugin de redução de ruído selecionado está indisponível. Instale-o ou "
"desative a redução de ruído."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/profiles.py:319
msgid "The audio plugin path is unsupported."
msgstr "O caminho do plugin de áudio não é compatível."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:32
msgid "There is not enough free disk space. Free some space and try again."
msgstr "Não há espaço livre suficiente. Libere espaço e tente novamente."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:39
msgid "The file or destination is not accessible. Check its permissions."
msgstr ""
"Não é possível acessar o arquivo ou a pasta de destino. Confira as "
"permissões."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:46
msgid ""
"The required audio encoder is unavailable. Install a compatible FFmpeg "
"package."
msgstr ""
"O codificador de áudio necessário está indisponível. Instale uma versão "
"compatível do FFmpeg."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:53
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "Um efeito selecionado está indisponível nesta instalação do FFmpeg."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:59
msgid ""
"The audio could not be processed. Check the file and selected output "
"settings."
msgstr ""
"Não foi possível processar o áudio. Confira o arquivo e as configurações de "
"saída."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:150
msgid ""
"Effects require re-encoding. Select an audio format instead of Fast Copy."
msgstr ""
"Os efeitos exigem conversão. Escolha um formato de áudio em vez da cópia sem "
"conversão."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:248
msgid "An intermediate segment has an unsafe path."
msgstr "Um trecho intermediário tem um caminho inseguro."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/segment_processor.py:331
msgid "The output contains no readable audio. No file was published."
msgstr "O resultado não contém áudio legível. Nenhum arquivo foi salvo."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/waveform.py:56
msgid "The audio contains non-finite samples."
msgstr "O áudio contém amostras com valores inválidos."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/waveform.py:98
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "O áudio decodificado termina com uma amostra incompleta."

#: big-audio-converter/usr/share/biglinux/audio-converter/app/audio/waveform.py:101
msgid "The file contains no readable audio samples."
msgstr "O arquivo não contém amostras de áudio legíveis."

