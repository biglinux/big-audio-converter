#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:19
msgid "Welcome"
msgstr "Bun venit"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:33
msgid "Convert audio in three steps"
msgstr "Convertește sunetul în trei pași"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:39
msgid "1. Add your files"
msgstr "1. Adaugă fișierele"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:40
msgid "Audio or video. Each audio track of a video becomes its own entry."
msgstr "Audio sau video. Fiecare pistă audio dintr-un videoclip devine o intrare separată."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:43
msgid "2. Choose what to make"
msgstr "2. Alege ce vrei să obții"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:45
msgid "Pick a format and, if you want, clean the voice, cut parts or adjust the sound."
msgstr "Alege un format și, dacă vrei, curăță vocea, taie părți sau ajustează sunetul."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:49
msgid "3. Convert"
msgstr "3. Convertește"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:50
msgid "New files appear next to the originals, which are never changed."
msgstr "Fișierele noi apar lângă originale, care nu sunt modificate niciodată."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:60
msgid "Show dialog on startup"
msgstr "Arată acest dialog la pornire"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:71
msgid "Let's Start"
msgstr "Începe"

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:10
msgid "Sets the format, quality and sound for a common use. Changing any of them shows Custom."
msgstr "Setează formatul, calitatea și sunetul pentru o utilizare obișnuită. Modificarea oricăruia afișează „Personalizat”."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:13
msgid "Choose the output format. Keeping the original format applies no effects."
msgstr "Alege formatul de ieșire. Păstrarea formatului original nu aplică efecte."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:16
msgid "Higher quality sounds better and makes larger files. Each choice shows its size per minute."
msgstr "O calitate mai mare sună mai bine și produce fișiere mai mari. Fiecare opțiune își arată dimensiunea pe minut."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:19
msgid "Changes preview and export volume. Values above 100% can distort the audio."
msgstr "Modifică volumul previzualizării și al exportului. Valorile peste 100% pot distorsiona sunetul."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:21
msgid "Changes preview and export speed while preserving pitch."
msgstr "Modifică viteza previzualizării și a exportului fără a schimba înălțimea sunetului."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:23
msgid "Reduce noise in speech with DeepFilterNet3 or DPDFNet. Not intended for music."
msgstr "Reduce zgomotul din vorbire cu DeepFilterNet3 sau DPDFNet. Nu este destinat muzicii."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:25
msgid "Reduce quiet background sound between spoken phrases."
msgstr "Atenuează sunetele slabe de fundal dintre fraze."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:27
msgid "Brings every file to the same loudness. This changes the original volume."
msgstr "Aduce toate fișierele la aceeași intensitate sonoră. Aceasta modifică volumul original."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:29
msgid "Choose the order in which marked segments are exported."
msgstr "Alege ordinea în care sunt exportate segmentele marcate."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:30
msgid "Export each segment separately or join the selected segments."
msgstr "Exportă fiecare segment separat sau unește segmentele selectate."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:31
msgid "Keep the original layout or explicitly downmix to mono or stereo."
msgstr "Păstrează configurația originală a canalelor sau mixează-le în mono ori stereo."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:33
msgid "Click to listen from a point. Drag to mark a part, then drag its edges or body to adjust it. Edit Segments provides numeric and keyboard controls."
msgstr "Clic pentru a asculta de la un punct. Trage pentru a marca o parte, apoi trage de marginile sau de mijlocul ei pentru a o ajusta. „Editează segmente” oferă controale numerice și de la tastatură."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:36
msgid "Remove all entries from the queue without deleting source files."
msgstr "Elimină toate elementele din coadă fără a șterge fișierele sursă."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:38
msgid "Preview the previous file."
msgstr "Ascultă fișierul anterior."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:39
msgid "Play or pause. Keyboard shortcut: Ctrl+Space."
msgstr "Pornește sau întrerupe redarea. Scurtătură de tastatură: Ctrl+Spațiu."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:40
msgid "Preview the next file."
msgstr "Ascultă fișierul următor."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:41
msgid "Preview only the marked segments."
msgstr "Ascultă doar segmentele marcate."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:42
msgid "Show the equalizer. Its settings affect exported audio."
msgstr "Afișează egalizatorul. Setările sale afectează sunetul exportat."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:43
msgid "Preview this audio file."
msgstr "Ascultă acest fișier audio."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:44
msgid "Remove this entry without deleting the source file."
msgstr "Elimină acest element fără a șterge fișierul sursă."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:46
msgid "More actions are available from the adjacent menu button."
msgstr "Butonul de meniu alăturat oferă mai multe acțiuni."

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:24
msgid "Extract Audio"
msgstr "Extrage sunetul"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:24
msgid "Convert or Edit Audio"
msgstr "Convertește sau editează sunetul"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:49
msgid "No local media files"
msgstr "Niciun fișier media local"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:50
msgid "Download remote files before converting them."
msgstr "Descarcă fișierele de la distanță înainte de a le converti."

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:68
msgid "Application Launch Error"
msgstr "Eroare la pornirea aplicației"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:70
