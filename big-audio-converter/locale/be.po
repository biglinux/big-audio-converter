#: usr/share/biglinux/audio-converter/main.py:86
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1318
msgid "Local files only"
msgstr "Толькі лакальныя файлы"

#: usr/share/biglinux/audio-converter/main.py:87
msgid "Download this file to a local folder before adding it."
msgstr "Перш чым дадаць гэты файл, спампуйце яго ў лакальную папку."

#: usr/share/biglinux/audio-converter/main.py:192
#: usr/share/biglinux/audio-converter/main.py:216
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:213
msgid "Audio Converter"
msgstr "Аўдыяканвертар"

#: usr/share/biglinux/audio-converter/main.py:194
#: usr/share/biglinux/audio-converter/main.py:196
msgid "BigLinux Team"
msgstr "Каманда BigLinux"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:61
msgid "The application is closing."
msgstr "Праграма закрываецца."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:65
msgid "A conversion is still running. Wait for it to finish cancelling before starting another."
msgstr "Пераўтварэнне яшчэ выконваецца. Дачакайцеся завяршэння скасавання, перш чым пачынаць новае."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:111
msgid "Conversion cancelled."
msgstr "Пераўтварэнне скасавана."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:132
msgid "The output path is invalid. Check the source filename and destination."
msgstr "Недапушчальны выхадны шлях. Праверце назву зыходнага файла і папку прызначэння."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:159
msgid "An unexpected error stopped this conversion."
msgstr "Нечаканая памылка спыніла гэта пераўтварэнне."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:188
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr "FFmpeg не ўсталяваны. Усталюйце пакет FFmpeg і паўтарыце спробу."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:219
msgid "Fast Copy cannot apply effects, change channels or resample. Select an encoding format."
msgstr "Хуткае капіяванне не можа ўжываць эфекты, змяняць каналы або частату дыскрэтызацыі. Выберыце фармат кадзіравання."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:230
msgid "Fast Copy preserves encoded audio packets; cut boundaries are approximate. Effects are not applied."
msgstr "Хуткае капіяванне захоўвае кадаваныя аўдыяпакеты; межы абразання прыблізныя. Эфекты не ўжываюцца."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:244
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "Гук з рухомай коскай з яўнага дазволу пераўтвораны ў 24-бітны цэлалікавы PCM для FLAC; гэта не пабітава дакладная копія."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:250
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Opus выкарыстоўвае тактавую частату дыскрэтызацыі 48 кГц пры прайграванні. Зыходную частату дыскрэтызацыі нельга прадставіць без змен у выхадным кантэйнеры."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:257
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "Выхадны кодэк патрабуе перадыскрэтызацыі з {rate} Гц да {final_rate} Гц."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:272
msgid "Positive gain may clip. Enable clipping protection or reduce the gain."
msgstr "Станоўчае ўзмацненне можа выклікаць кліпінг. Уключыце абарону ад кліпінгу або паменшыце ўзмацненне."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:278
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "Гэты фармат неапрацаванага гуку не можа захаваць усе тэгі і вокладкі."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:285
msgid "Artwork is not preserved by this output profile."
msgstr "Гэты выхадны профіль не захоўвае вокладкі."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:351
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "Зыходны файл змяніўся падчас пераўтварэння. Канчатковы файл не захаваны; дадайце зыходны файл зноў."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:369
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Пераўтварэнне скасавана. Незавершаныя выхадныя файлы не захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:383
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "Не ўдалося атрымаць доступ да файла або папкі прызначэння. Праверце правы доступу і вольнае месца на дыску."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:392
msgid "The media information or conversion settings are invalid."
msgstr "Недапушчальныя звесткі пра медыяфайл або налады пераўтварэння."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:409
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "Кадавальнік змяніў запытаную частату дыскрэтызацыі. Канчатковы файл не захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:417
msgid "The encoder changed the requested channel count. No output was published."
msgstr "Кадавальнік змяніў запытаную колькасць каналаў. Канчатковы файл не захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:425
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "Гэта зборка FFmpeg не можа захаваць запытаную дакладнасць FLAC. Выберыце WAV або ўсталюйце сумяшчальны пакет FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:444
#: usr/share/biglinux/audio-converter/app/audio/profiles.py:172
msgid "Select a supported output format."
msgstr "Выберыце выхадны фармат, які падтрымліваецца."

#: usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "Выберыце дапушчальны лакальны медыяфайл."

#: usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "Зыходны файл адсутнічае або не з’яўляецца звычайным файлам."

#: usr/share/biglinux/audio-converter/app/audio/media.py:39
msgid "The selected audio track is invalid. Add the file again."
msgstr "Выбраная аўдыядарожка недапушчальная. Дадайце файл зноў."

#: usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "Зыходнае відэа адсутнічае. Дадайце файл зноў."

#: usr/share/biglinux/audio-converter/app/audio/media.py:65
msgid "A segment has invalid start or end times."
msgstr "Фрагмент мае недапушчальны час пачатку або канца."

#: usr/share/biglinux/audio-converter/app/audio/media.py:70
msgid "Every segment must have a finite end time after its start."
msgstr "Кожны фрагмент павінен мець канечны час завяршэння, пазнейшы за час пачатку."

#: usr/share/biglinux/audio-converter/app/audio/media.py:79
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "Фрагмент выходзіць за межы зыходнага гуку. Удакладніце час яго канца."

#: usr/share/biglinux/audio-converter/app/audio/media.py:85
msgid "A segment must contain at least one audio sample."
msgstr "Фрагмент павінен утрымліваць хаця б адзін гукавы адлік."

#: usr/share/biglinux/audio-converter/app/audio/media.py:171
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr "FFprobe не ўсталяваны. Усталюйце пакет FFmpeg і паўтарыце спробу."

#: usr/share/biglinux/audio-converter/app/audio/media.py:198
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr "Не ўдалося прачытаць медыяфайл. Магчыма, ён пашкоджаны або не падтрымліваецца."

#: usr/share/biglinux/audio-converter/app/audio/media.py:206
msgid "FFprobe returned invalid media information."
msgstr "FFprobe вярнуў недапушчальныя звесткі пра медыяфайл."

#: usr/share/biglinux/audio-converter/app/audio/media.py:211
msgid "FFprobe returned incomplete media information."
msgstr "FFprobe вярнуў няпоўныя звесткі пра медыяфайл."

#: usr/share/biglinux/audio-converter/app/audio/media.py:224
msgid "This file does not contain the selected audio track."
msgstr "Гэты файл не ўтрымлівае выбранай аўдыядарожкі."

#: usr/share/biglinux/audio-converter/app/audio/media.py:269
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr "Выбраны кадавальнік WAV не можа захаваць гэту дакладнасць PCM."

#: usr/share/biglinux/audio-converter/app/audio/player.py:157
msgid "Audio preview is unavailable. Install mpv and python-mpv, then reopen the application."
msgstr "Папярэдняе праслухоўванне недаступнае. Усталюйце mpv і python-mpv, а затым зноў адкрыйце праграму."

#: usr/share/biglinux/audio-converter/app/audio/player.py:184
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr "Не ўдалося атрымаць спіс аўдыявыхадаў. Паспрабуйце зноў адкрыць выбар выхаду."

#: usr/share/biglinux/audio-converter/app/audio/player.py:206
msgid "The selected audio output was disconnected. Playback is paused. Choose an output or resume using the system default."
msgstr "Выбраны аўдыявыхад адлучаны. Прайграванне прыпынена. Выберыце выхад або працягніце з прадвызначаным выхадам сістэмы."

#: usr/share/biglinux/audio-converter/app/audio/player.py:219
msgid "This audio output is no longer available. Choose another output."
msgstr "Гэты аўдыявыхад больш недаступны. Выберыце іншы."

#: usr/share/biglinux/audio-converter/app/audio/player.py:231
msgid "The audio output could not be selected. Choose another output."
msgstr "Не ўдалося выбраць аўдыявыхад. Выберыце іншы."

#: usr/share/biglinux/audio-converter/app/audio/player.py:257
msgid "The selected audio track is unavailable. Add the file again."
msgstr "Выбраная аўдыядарожка недаступная. Дадайце файл зноў."

#: usr/share/biglinux/audio-converter/app/audio/player.py:289
msgid "The audio could not be played. Check the file and audio output device."
msgstr "Не ўдалося прайграць гук. Праверце файл і прыладу вываду гуку."

#: usr/share/biglinux/audio-converter/app/audio/player.py:415
msgid "This audio position could not be reached."
msgstr "Не ўдалося перайсці да гэтай пазіцыі ў гуку."

#: usr/share/biglinux/audio-converter/app/audio/player.py:467
msgid "A preview effect could not be applied. Check the selected effects and installed plugins."
msgstr "Не ўдалося ўжыць эфект праслухоўвання. Праверце выбраныя эфекты і ўсталяваныя ўбудовы."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:59
msgid "Too many files are waiting for inspection. Wait for some files to finish, then add more."
msgstr "Занадта шмат файлаў чакаюць аналізу. Дачакайцеся завяршэння аналізу часткі файлаў, а потым дадайце новыя."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:80
msgid "Select a regular local media file, not a folder or device."
msgstr "Выберыце звычайны лакальны медыяфайл, а не папку або прыладу."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:100
msgid "The file changed during inspection. Add it again."
msgstr "Файл змяніўся падчас аналізу. Дадайце яго зноў."

#: usr/share/biglinux/audio-converter/app/audio/process.py:116
#: usr/share/biglinux/audio-converter/app/audio/process.py:144
msgid "The media command timed out."
msgstr "Перавышаны час чакання каманды апрацоўкі медыяфайла."

#: usr/share/biglinux/audio-converter/app/audio/process.py:134
msgid "The media information is too large to process safely."
msgstr "Звесткі пра медыяфайл занадта вялікія для бяспечнай апрацоўкі."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:130
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Недапушчальнае значэнне параметра {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:134
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "Значэнне параметра {key} павінна быць у межах ад {low} да {high}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:142
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Недапушчальнае значэнне пераключальніка {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:152
msgid "The equalizer bands are invalid."
msgstr "Недапушчальныя налады палос эквалайзера."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:159
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "Эквалайзеру патрэбны дзесяць канечных значэнняў узмацнення ў межах ад -40 да 40 дБ."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:163
msgid "Select a supported noise reduction mode."
msgstr "Выберыце рэжым шумапрыглушэння, які падтрымліваецца."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:188
msgid "FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow conversion to 24-bit PCM in Advanced encoding."
msgstr "FLAC не можа захаваць гэта прадстаўленне PCM. Выберыце WAV або яўна дазвольце пераўтварэнне ў 24-бітны PCM у пашыраных наладах кадзіравання."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:213
msgid "The selected bitrate is not supported by this output profile."
msgstr "Выбраны бітрэйт не падтрымліваецца гэтым выхадным профілем."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:220
msgid "Select original, mono or stereo channels."
msgstr "Выберыце зыходную схему каналаў, мона або стэрэа."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:228
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "MP3 падтрымлівае мона або стэрэа. Выберыце стэрэаканалы або іншы фармат."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:235
msgid "Select a valid output sample rate."
msgstr "Выберыце дапушчальную выхадную частату дыскрэтызацыі."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:242
msgid "The selected codec does not support that sample rate."
msgstr "Выбраны кодэк не падтрымлівае гэту частату дыскрэтызацыі."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:316
msgid "The selected noise reduction plugin is unavailable. Install it or turn noise reduction off."
msgstr "Выбраная ўбудова шумапрыглушэння недаступная. Усталюйце яе або выключыце шумапрыглушэнне."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:350
msgid "The audio plugin path is unsupported."
msgstr "Шлях да аўдыяўбудовы не падтрымліваецца."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:40
msgid "There is not enough free disk space. Free some space and try again."
msgstr "Недастаткова вольнага месца на дыску. Вызваліце месца і паўтарыце спробу."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:47
msgid "The file or destination is not accessible. Check its permissions."
msgstr "Няма доступу да файла або папкі прызначэння. Праверце правы доступу."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:54
msgid "The required audio encoder is unavailable. Install a compatible FFmpeg package."
msgstr "Патрэбны аўдыякадавальнік недаступны. Усталюйце сумяшчальны пакет FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:61
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "Выбраны аўдыяэфект недаступны ў гэтай усталёўцы FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:67
msgid "The audio could not be processed. Check the file and selected output settings."
msgstr "Не ўдалося апрацаваць гук. Праверце файл і выбраныя выхадныя налады."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:158
msgid "Effects require re-encoding. Select an audio format instead of Fast Copy."
msgstr "Эфекты патрабуюць перакадзіравання. Выберыце аўдыяфармат замест хуткага капіявання."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:289
msgid "An intermediate segment has an unsafe path."
msgstr "Прамежкавы фрагмент мае небяспечны шлях."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:372
msgid "The output contains no readable audio. No file was published."
msgstr "Выхадныя даныя не ўтрымліваюць гуку, які можна прачытаць. Канчатковы файл не захаваны."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:56
msgid "The audio contains non-finite samples."
msgstr "Гук утрымлівае адлікі з бясконцымі або нелікавымі значэннямі."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:98
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "Дэкадаваны гук заканчваецца няпоўным кадрам адлікаў."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:101
msgid "The file contains no readable audio samples."
msgstr "Файл не ўтрымлівае гукавых адлікаў, якія можна прачытаць."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:239
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:164
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:202
msgid "Generating waveform..."
msgstr "Пабудова гукавой хвалі…"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:247
msgid "FFmpeg is not installed."
msgstr "FFmpeg не ўсталяваны."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:300
msgid "The waveform could not be generated."
msgstr "Не ўдалося пабудаваць гукавую хвалю."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:319
msgid "The source changed while its waveform was being generated."
msgstr "Зыходны файл змяніўся падчас пабудовы гукавой хвалі."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:37
msgid "Inspecting audio"
msgstr "Аналіз гуку"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:39
msgid "Files are still being inspected. Conversion will be available when inspection finishes."
msgstr "Аналіз файлаў яшчэ працягваецца. Пераўтварэнне стане даступным пасля яго завяршэння."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:46
msgid "No files to convert"
msgstr "Няма файлаў для пераўтварэння"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:46
msgid "Please add at least one file to convert."
msgstr "Дадайце хаця б адзін файл для пераўтварэння."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:57
msgid "Check conversion settings"
msgstr "Праверце налады пераўтварэння"

