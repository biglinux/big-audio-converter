#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:50
msgid "Download remote files before converting them."
msgstr "Спампуйце аддаленыя файлы перад пераўтварэннем."

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:68
msgid "Application Launch Error"
msgstr "Памылка запуску праграмы"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:70
msgid "Big Audio Converter could not be started. Check that it is installed."
msgstr "Не ўдалося запусціць Big Audio Converter. Праверце, ці ўсталявана праграма."

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:384
msgid "Each audio track of a video becomes its own entry."
msgstr "Кожная гукавая дарожка відэа становіцца асобным запісам."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:101
msgid "Only for floating-point audio saved as FLAC. It lowers the precision. WAV keeps the original as it is."
msgstr "Толькі для гуку з рухомай коскай, які захоўваецца ў FLAC. Дакладнасць зніжаецца. WAV пакідае арыгінал як ёсць."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:124
msgid "If you are not sure, pick MP3. It plays on any device."
msgstr "Калі сумняваецеся, выберыце MP3. Ён прайграецца на любой прыладзе."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:168
msgid "The higher the bitrate, the better the sound and the bigger the file."
msgstr "Чым вышэйшы бітрэйт, тым лепшы гук і тым большы файл."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:283
msgid "Keep saves only the segments you marked. Remove takes them out and saves the rest."
msgstr "«Пакінуць іх» захоўвае толькі пазначаныя фрагменты. «Выдаліць іх» выразае гэтыя фрагменты і захоўвае астатняе."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:294
msgid "The segments can follow the audio from start to end, or the order in which you marked them."
msgstr "Фрагменты могуць ісці па ходзе запісу ад пачатку да канца або ў тым парадку, як вы іх пазначылі."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:304
msgid "Each segment can become its own file, or they can all go into one."
msgstr "Кожны фрагмент можа стаць асобным файлам, або ўсе яны могуць трапіць у адзін."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:315
msgid "Puts all the files in the queue into one, in the order they appear. It is named after the first file."
msgstr "Аб’ядноўвае ўсе файлы ў чарзе ў адзін, у тым парадку, у якім яны ідуць. Ён атрымлівае назву першага файла."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:379
msgid "Keep it on Original. Mono makes the file about half the size."
msgstr "Пакіньце «Зыходныя». Мона памяншае файл прыкладна ўдвая."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:393
msgid "Leave it on Original unless a device or website asks for a specific rate."
msgstr "Пакіньце «Зыходныя», калі прылада або сайт не патрабуе пэўнай частаты."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:406
msgid "Evens out the volume between files, so when you play several in a row none sounds louder or quieter than the others."
msgstr "Выраўноўвае гучнасць паміж файламі, каб пры прайграванні некалькіх запар ніводзін не гучаў гучней ці цішэй за іншыя."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:416
msgid "Works inside each file, making its quiet parts louder and its loud parts softer. Standard volume evens out whole files instead."
msgstr "Працуе ўнутры кожнага файла, робячы ціхія месцы гучнейшымі, а гучныя цішэйшымі. А «Стандартная гучнасць» выраўноўвае цэлыя файлы."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:440
msgid "Finds the silences between sentences and leaves them out of the saved file."
msgstr "Знаходзіць цішыню паміж сказамі і не ўключае яе ў захаваны файл."

#: usr/share/biglinux/audio-converter/app/ui/help_tooltips.py:19
msgid "Set the exact times of each segment. Keyboard shortcut: Ctrl+E."
msgstr "Задаць дакладны час кожнага фрагмента. Спалучэнне клавіш: Ctrl+E."

#: usr/share/biglinux/audio-converter/app/ui/playback_panel.py:134
msgid "Zoom"
msgstr "Маштаб"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:147
msgid "Adjust to the number of channels"
msgstr "Падладжваць пад колькасць каналаў"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:149
msgid "The quality above is for stereo. Mono uses half of it, and 5.1 three times as much."
msgstr "Якасць вышэй разлічана на стэрэа. Мона выкарыстоўвае палову, а 5.1 выкарыстоўвае ўтрая больш."

#: usr/share/biglinux/audio-converter/app/audio/pauses.py:117
msgid "Update dpdfnet-native to find pauses."
msgstr "Абнавіце dpdfnet-native, каб шукаць паўзы."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:79
msgid "Not every audio track of this video was converted in this run, so the original was kept."
msgstr "Не ўсе гукавыя дарожкі гэтага відэа былі пераўтвораны ў гэтым запуску, таму арыгінал захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:84
msgid "The converted file holds only part of the original, so the original was kept."
msgstr "Пераўтвораны файл утрымлівае толькі частку арыгінала, таму арыгінал захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:104
msgid "The original was moved to the Trash."
msgstr "Арыгінал перамешчаны ў сметніцу."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:128
msgid "The original is a link and was kept; its target is not moved."
msgstr "Арыгінал з’яўляецца спасылкай і захаваны; файл, на які яна ўказвае, не перамяшчаецца."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:132
msgid "The original changed after it was converted and was kept."
msgstr "Арыгінал змяніўся пасля пераўтварэння і захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:139
msgid "The converted file could not be verified, so the original was kept."
msgstr "Не ўдалося праверыць пераўтвораны файл, таму арыгінал захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:150
msgid "The original could not be moved to the Trash and was kept."
msgstr "Не ўдалося перамясціць арыгінал у сметніцу, таму ён захаваны."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:351
msgid "Delete original files"
msgstr "Выдаляць зыходныя файлы"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:946
msgid "Originals go to the Trash only after every file converted from them is checked"
msgstr "Арыгіналы трапляюць у сметніцу толькі пасля праверкі кожнага файла, пераўтворанага з іх"

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:57
msgid "Converted, original kept"
msgstr "Пераўтворана, арыгінал захаваны"

#: usr/share/biglinux/audio-converter/app/ui/playback_panel.py:178 usr/share/biglinux/audio-converter/app/ui/playback.py:356
msgid "Play"
msgstr "Прайграць"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:703
msgid "Format, quality, output folder, deleting originals, cutting, effects and equalizer return to their defaults. The queue and your source files are kept."
msgstr "Фармат, якасць, выхадная папка, выдаленне зыходных файлаў, абразанне, эфекты і эквалайзер вернуцца да прадвызначаных значэнняў. Чарга і зыходныя файлы захаваюцца."

#: usr/share/biglinux/audio-converter/app/ui/playback.py:356
msgid "Pause"
msgstr "Прыпыніць"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:74
msgid "Another entry made from this original was not converted, so the original was kept."
msgstr "Іншы запіс, створаны з гэтага арыгінала, не быў пераўтвораны, таму арыгінал захаваны."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:102
msgid "The original was deleted."
msgstr "Арыгінал выдалены."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:148
msgid "The original could not be deleted and was kept."
msgstr "Не ўдалося выдаліць арыгінал, таму ён захаваны."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:941
msgid "Originals are deleted permanently, without the Trash, only after every file converted from them is checked"
msgstr "Арыгіналы выдаляюцца назаўсёды, абмінаючы сметніцу, толькі пасля праверкі кожнага файла, пераўтворанага з іх"

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:279 usr/share/biglinux/audio-converter/app/ui/file_queue.py:651
msgid "Delete Permanently"
msgstr "Выдаліць назаўсёды"

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:637
msgid "Cancel the conversion or wait for it to finish before deleting its input."
msgstr "Скасуйце пераўтварэнне або дачакайцеся яго завяршэння, перш чым выдаляць уваходны файл."

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:645
msgid "Delete File Permanently?"
msgstr "Выдаліць файл назаўсёды?"

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:647
#, python-brace-format
msgid "'{name}' will be deleted without going to the Trash and cannot be recovered. All of its tracks will be removed from the queue."
msgstr "Файл «{name}» будзе выдалены, абмінаючы сметніцу, і яго нельга будзе аднавіць. Усе яго дарожкі будуць прыбраныя з чаргі."

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:673
msgid "The file is in use by a conversion. Cancel it before deleting the input."
msgstr "Файл выкарыстоўваецца пры пераўтварэнні. Скасуйце яго, перш чым выдаляць уваходны файл."

#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:688
msgid "The file could not be deleted."
msgstr "Не ўдалося выдаліць файл."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:323
msgid "Delete Without Using the Trash"
msgstr "Выдаляць без выкарыстання сметніцы"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:247 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:87
msgid "Very sensitive"
msgstr "Вельмі адчувальнае"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:248 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:88
msgid "Sensitive"
msgstr "Адчувальнае"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:249 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:89
msgid "Normal"
msgstr "Звычайнае"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:250 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:90
msgid "Strict"
msgstr "Строгае"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:251 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:91
msgid "Very strict"
msgstr "Вельмі строгае"

#: usr/share/biglinux/audio-converter/app/ui/pause_panel.py:103
msgid "Sensitive keeps quiet or unusual voices and lets more noise and music through; strict removes more music and may cut faint words."
msgstr "Адчувальнае выяўленне захоўвае ціхія ці незвычайныя галасы і прапускае больш шуму і музыкі; строгае прыбірае больш музыкі і можа абрэзаць ціхія словы."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:263 usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:267 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:108 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:112
msgid "Voice detection"
msgstr "Выяўленне голасу"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:232
msgid "Audio only when a voice is detected"
msgstr "Гук толькі пры выяўленні голасу"
