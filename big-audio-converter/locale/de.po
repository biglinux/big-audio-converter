#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:144 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:83
msgid "Try Again"
msgstr "Erneut versuchen"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:147
#, python-brace-format
msgid "{count} file converted"
msgid_plural "{count} files converted"
msgstr[0] "{count} Datei konvertiert"
msgstr[1] "{count} Dateien konvertiert"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:149
msgid "Show Files"
msgstr "Dateien anzeigen"

#: usr/share/biglinux/audio-converter/app/ui/effect_cards.py:164 usr/share/biglinux/audio-converter/app/ui/main_window.py:1145
msgid "Reset"
msgstr "Zurücksetzen"

#: usr/share/biglinux/audio-converter/app/ui/effect_cards.py:307 usr/share/biglinux/audio-converter/app/ui/effect_cards.py:325 usr/share/biglinux/audio-converter/app/ui/pause_panel.py:236
msgid "Off"
msgstr "Aus"

#: usr/share/biglinux/audio-converter/app/ui/effect_cards.py:325
msgid "On"
msgstr "An"

#: usr/share/biglinux/audio-converter/app/ui/effect_cards.py:394
#, python-brace-format
msgid "{count} active"
msgid_plural "{count} active"
msgstr[0] "{count} aktiv"
msgstr[1] "{count} aktiv"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:45
msgid "Default Voice"
msgstr "Standardstimme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:49
msgid "Natural (No Effects)"
msgstr "Natürlich (ohne Effekte)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:53
msgid "Crystal Voice"
msgstr "Kristallklare Stimme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:57
msgid "Radio Host"
msgstr "Radiostimme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:61
msgid "Velvet Voice"
msgstr "Samtweiche Stimme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:65
msgid "Extra Brightness"
msgstr "Mehr Brillanz"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:69
msgid "Soften 'S' (De-esser)"
msgstr "S-Laute abmildern (De-Esser)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:73
msgid "Remove Rumble"
msgstr "Rumpeln entfernen"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:77
msgid "Present Voice"
