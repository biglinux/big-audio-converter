#: usr/share/biglinux/audio-converter/app/audio/converter.py:64
msgid "The application is closing."
msgstr "Die Anwendung wird geschlossen."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:68
msgid "A conversion is still running. Wait for it to finish cancelling before starting another."
msgstr "Eine Konvertierung läuft noch. Warten Sie, bis der Abbruch abgeschlossen ist, bevor Sie eine weitere starten."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:122
msgid "Conversion cancelled."
msgstr "Konvertierung abgebrochen."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:144
msgid "The output path is invalid. Check the source filename and destination."
msgstr "Der Ausgabepfad ist ungültig. Prüfen Sie den Namen der Quelldatei und das Ziel."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:173
#, python-brace-format
msgid "Joined into {name}"
msgstr "Zusammengefügt in {name}"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:188
msgid "An unexpected error stopped this conversion."
msgstr "Ein unerwarteter Fehler hat diese Konvertierung gestoppt."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:227
msgid "The length of this file is unknown, so marked segments cannot be removed. Keep them instead."
msgstr "Die Länge dieser Datei ist unbekannt, daher können markierte Abschnitte nicht entfernt werden. Wählen Sie stattdessen „Behalten“."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:238
msgid "The whole file is marked for removal."
msgstr "Die gesamte Datei ist zum Entfernen markiert."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:253
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr "FFmpeg ist nicht installiert. Installieren Sie das FFmpeg-Paket und versuchen Sie es erneut."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:268
msgid "Keeping the original format cannot join files. Select an audio format."
msgstr "Mit beibehaltenem Originalformat lassen sich keine Dateien verbinden. Wählen Sie ein Audioformat."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:278
msgid "Files with more than two channels can only be joined as mono or stereo. Choose Mono or Stereo under Channels."
msgstr "Dateien mit mehr als zwei Kanälen können nur als Mono oder Stereo zusammengefügt werden. Wählen Sie Mono oder Stereo unter Kanäle."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:298
msgid "Keeping the original format cannot apply effects, change channels or resample. Select an audio format."
msgstr "Mit beibehaltenem Originalformat lassen sich keine Effekte anwenden, Kanäle ändern oder Abtastraten umrechnen. Wählen Sie ein Audioformat."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:309
msgid "The original format keeps the encoded audio, so cuts are approximate and effects are not applied."
msgstr "Das Originalformat behält den kodierten Ton, daher sind Schnitte ungefähr und Effekte werden nicht angewendet."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:328
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "Das Gleitkomma-Audio wurde wie ausdrücklich erlaubt für FLAC in ganzzahliges 24-Bit-PCM konvertiert; dies ist keine bitgenaue Kopie."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:334
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Opus verwendet bei der Wiedergabe einen Abtasttakt von 48 kHz. Die ursprüngliche Abtastrate lässt sich im Ausgabecontainer nicht unverändert darstellen."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:341
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "Der Ausgabecodec erfordert eine Änderung der Abtastrate von {rate} Hz auf {final_rate} Hz."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:353
msgid "Raising the volume may distort. Turn on Standard volume or lower the volume."
msgstr "Eine höhere Lautstärke kann verzerren. Aktivieren Sie Standardlautstärke oder verringern Sie die Lautstärke."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:359
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "Dieses rohe Audioformat kann nicht alle Tags oder Coverbilder erhalten."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:366
msgid "Artwork is not preserved by this output profile."
msgstr "Coverbilder werden von diesem Ausgabeprofil nicht erhalten."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:432
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "Die Quelldatei hat sich während der Konvertierung geändert. Es wurde keine Ausgabedatei gespeichert; fügen Sie die Datei erneut hinzu."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:450
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Konvertierung abgebrochen. Es wurden keine unvollständigen Ausgabedateien gespeichert."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:464
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "Auf die Datei oder das Ziel konnte nicht zugegriffen werden. Prüfen Sie die Zugriffsrechte und den freien Speicherplatz."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:473
msgid "The media information or conversion settings are invalid."
msgstr "Die Medieninformationen oder Konvertierungseinstellungen sind ungültig."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:490
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "Der Encoder hat die angeforderte Abtastrate geändert. Es wurde keine Ausgabedatei gespeichert."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:498
msgid "The encoder changed the requested channel count. No output was published."
msgstr "Der Encoder hat die angeforderte Kanalanzahl geändert. Es wurde keine Ausgabedatei gespeichert."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:506
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "Diese FFmpeg-Version kann die angeforderte FLAC-Genauigkeit nicht erhalten. Wählen Sie WAV oder installieren Sie ein kompatibles FFmpeg-Paket."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:524
#: usr/share/biglinux/audio-converter/app/audio/profiles.py:165
msgid "Select a supported output format."
msgstr "Wählen Sie ein unterstütztes Ausgabeformat."

#: usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "Wählen Sie eine gültige lokale Mediendatei."

#: usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "Die Quelldatei fehlt oder ist keine reguläre Datei."

#: usr/share/biglinux/audio-converter/app/audio/media.py:39
msgid "The selected audio track is invalid. Add the file again."
msgstr "Die ausgewählte Audiospur ist ungültig. Fügen Sie die Datei erneut hinzu."

#: usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "Das Quellvideo fehlt. Fügen Sie die Datei erneut hinzu."

#: usr/share/biglinux/audio-converter/app/audio/media.py:83
msgid "A segment has invalid start or end times."
msgstr "Ein Abschnitt hat ungültige Start- oder Endzeiten."

#: usr/share/biglinux/audio-converter/app/audio/media.py:88
msgid "Every segment must have a finite end time after its start."
msgstr "Jeder Abschnitt benötigt eine endliche Endzeit, die nach seiner Startzeit liegt."

#: usr/share/biglinux/audio-converter/app/audio/media.py:97
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "Ein Abschnitt reicht über das Quellaudio hinaus. Passen Sie seine Endzeit an."

#: usr/share/biglinux/audio-converter/app/audio/media.py:103
msgid "A segment must contain at least one audio sample."
msgstr "Ein Abschnitt muss mindestens ein Audiosample enthalten."

#: usr/share/biglinux/audio-converter/app/audio/media.py:184
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr "FFprobe ist nicht installiert. Installieren Sie das FFmpeg-Paket und versuchen Sie es erneut."

#: usr/share/biglinux/audio-converter/app/audio/media.py:211
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr "Die Mediendatei konnte nicht gelesen werden. Sie ist möglicherweise beschädigt oder wird nicht unterstützt."

#: usr/share/biglinux/audio-converter/app/audio/media.py:219
msgid "FFprobe returned invalid media information."
msgstr "FFprobe hat ungültige Medieninformationen zurückgegeben."

#: usr/share/biglinux/audio-converter/app/audio/media.py:224
msgid "FFprobe returned incomplete media information."
msgstr "FFprobe hat unvollständige Medieninformationen zurückgegeben."

#: usr/share/biglinux/audio-converter/app/audio/media.py:237
msgid "This file does not contain the selected audio track."
msgstr "Diese Datei enthält die ausgewählte Audiospur nicht."

#: usr/share/biglinux/audio-converter/app/audio/media.py:282
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr "Der ausgewählte WAV-Encoder kann diese PCM-Genauigkeit nicht erhalten."

#: usr/share/biglinux/audio-converter/app/audio/media_probe.py:59
msgid "Too many files are waiting for inspection. Wait for some files to finish, then add more."
msgstr "Zu viele Dateien warten auf die Prüfung. Warten Sie, bis einige Dateien geprüft wurden, und fügen Sie dann weitere hinzu."

#: usr/share/biglinux/audio-converter/app/audio/media_probe.py:80
msgid "Select a regular local media file, not a folder or device."
msgstr "Wählen Sie eine reguläre lokale Mediendatei, keinen Ordner und kein Gerät."

#: usr/share/biglinux/audio-converter/app/audio/media_probe.py:94
msgid "The file changed during inspection. Add it again."
msgstr "Die Datei hat sich während der Prüfung geändert. Fügen Sie sie erneut hinzu."

#: usr/share/biglinux/audio-converter/app/audio/media_probe.py:129
msgid "The file could not be inspected. Add it again or choose another file."
msgstr "Die Datei konnte nicht untersucht werden. Fügen Sie sie erneut hinzu oder wählen Sie eine andere Datei."

#: usr/share/biglinux/audio-converter/app/audio/pauses.py:58
#: usr/share/biglinux/audio-converter/app/audio/pauses.py:105
#: usr/share/biglinux/audio-converter/app/audio/pauses.py:211
#: usr/share/biglinux/audio-converter/app/ui/pause_panel.py:337
msgid "The pauses could not be measured."
msgstr "Die Pausen konnten nicht gemessen werden."

#: usr/share/biglinux/audio-converter/app/audio/player.py:156
msgid "Audio preview is unavailable. Install mpv and python-mpv, then reopen the application."
msgstr "Die Audiovorschau ist nicht verfügbar. Installieren Sie mpv und python-mpv und öffnen Sie die Anwendung erneut."

#: usr/share/biglinux/audio-converter/app/audio/player.py:183
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr "Die Audioausgänge konnten nicht aufgelistet werden. Öffnen Sie die Ausgabeauswahl erneut."

#: usr/share/biglinux/audio-converter/app/audio/player.py:205
msgid "The selected audio output was disconnected. Playback is paused. Choose an output or resume using the system default."
msgstr "Der ausgewählte Audioausgang wurde getrennt. Die Wiedergabe ist angehalten. Wählen Sie einen Ausgang oder setzen Sie die Wiedergabe mit dem Systemstandard fort."

#: usr/share/biglinux/audio-converter/app/audio/player.py:218
msgid "This audio output is no longer available. Choose another output."
msgstr "Dieser Audioausgang ist nicht mehr verfügbar. Wählen Sie einen anderen."

#: usr/share/biglinux/audio-converter/app/audio/player.py:230
msgid "The audio output could not be selected. Choose another output."
msgstr "Der Audioausgang konnte nicht ausgewählt werden. Wählen Sie einen anderen."

#: usr/share/biglinux/audio-converter/app/audio/player.py:256
msgid "The selected audio track is unavailable. Add the file again."
msgstr "Die ausgewählte Audiospur ist nicht verfügbar. Fügen Sie die Datei erneut hinzu."

#: usr/share/biglinux/audio-converter/app/audio/player.py:288
msgid "The audio could not be played. Check the file and audio output device."
msgstr "Das Audio konnte nicht abgespielt werden. Prüfen Sie die Datei und das Audioausgabegerät."

#: usr/share/biglinux/audio-converter/app/audio/player.py:414
msgid "This audio position could not be reached."
msgstr "Diese Audioposition konnte nicht angesteuert werden."

#: usr/share/biglinux/audio-converter/app/audio/player.py:461
msgid "A preview effect could not be applied. Check the selected effects and installed plugins."
msgstr "Ein Vorschau-Effekt konnte nicht angewendet werden. Prüfen Sie die ausgewählten Effekte und installierten Plugins."

#: usr/share/biglinux/audio-converter/app/audio/process.py:116
#: usr/share/biglinux/audio-converter/app/audio/process.py:144
msgid "The media command timed out."
msgstr "Das Zeitlimit für den Medienbefehl wurde überschritten."

#: usr/share/biglinux/audio-converter/app/audio/process.py:134
msgid "The media information is too large to process safely."
msgstr "Die Medieninformationen sind zu umfangreich, um sicher verarbeitet zu werden."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:123
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Ungültiger Wert für {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:127
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "{key} muss zwischen {low} und {high} liegen."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:135
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Ungültiger Ein-/Aus-Wert für {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:145
msgid "The equalizer bands are invalid."
msgstr "Die Equalizer-Bänder sind ungültig."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:152
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "Der Equalizer benötigt zehn endliche Verstärkungswerte zwischen -40 und 40 dB."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:156
msgid "Select a supported noise reduction mode."
msgstr "Wählen Sie einen unterstützten Modus für die Rauschreduzierung."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:181
msgid "FLAC cannot preserve this PCM representation. Choose WAV, or turn on Allow conversion to 24-bit PCM under Format."
msgstr "FLAC kann diese PCM-Darstellung nicht erhalten. Wählen Sie WAV oder schalten Sie unter Format „Konvertierung in 24-Bit-PCM zulassen“ ein."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:206
msgid "The selected bitrate is not supported by this output profile."
msgstr "Die ausgewählte Bitrate wird von diesem Ausgabeprofil nicht unterstützt."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:213
msgid "Select original, mono or stereo channels."
msgstr "Wählen Sie die ursprünglichen Kanäle, Mono oder Stereo."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:221
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "MP3 unterstützt Mono oder Stereo. Wählen Sie Stereokanäle oder ein anderes Format."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:228
msgid "Select a valid output sample rate."
msgstr "Wählen Sie eine gültige Ausgabe-Abtastrate."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:235
msgid "The selected codec does not support that sample rate."
msgstr "Der ausgewählte Codec unterstützt diese Abtastrate nicht."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:309
msgid "The selected noise reduction plugin is unavailable. Install it or turn noise reduction off."
msgstr "Das ausgewählte Plugin zur Rauschreduzierung ist nicht verfügbar. Installieren Sie es oder deaktivieren Sie die Rauschreduzierung."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:338
msgid "The audio plugin path is unsupported."
msgstr "Der Pfad des Audioplugins wird nicht unterstützt."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:40
msgid "There is not enough free disk space. Free some space and try again."
msgstr "Es ist nicht genügend freier Speicherplatz vorhanden. Geben Sie Speicherplatz frei und versuchen Sie es erneut."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:47
msgid "The file or destination is not accessible. Check its permissions."
msgstr "Auf die Datei oder das Ziel kann nicht zugegriffen werden. Prüfen Sie die Zugriffsrechte."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:54
msgid "The required audio encoder is unavailable. Install a compatible FFmpeg package."
msgstr "Der erforderliche Audioencoder ist nicht verfügbar. Installieren Sie ein kompatibles FFmpeg-Paket."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:61
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "Ein ausgewählter Audioeffekt ist in dieser FFmpeg-Installation nicht verfügbar."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:67
msgid "The audio could not be processed. Check the file and selected output settings."
msgstr "Das Audio konnte nicht verarbeitet werden. Prüfen Sie die Datei und die gewählten Ausgabeeinstellungen."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:164
msgid "Effects need a new encoding. Select an audio format instead of keeping the original."
msgstr "Effekte erfordern eine neue Kodierung. Wählen Sie ein Audioformat, statt das Original beizubehalten."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:320
msgid "An intermediate segment has an unsafe path."
msgstr "Ein Zwischenabschnitt hat einen unsicheren Pfad."

#: usr/share/biglinux/audio-converter/app/audio/segment_renderer.py:403
msgid "The output contains no readable audio. No file was published."
msgstr "Die Ausgabe enthält kein lesbares Audio. Es wurde keine Datei gespeichert."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:63
msgid "The audio contains non-finite samples."
msgstr "Das Audio enthält Samples mit nicht endlichen Werten."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:105
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "Das decodierte Audio endet mit einem unvollständigen Sample-Frame."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:108
msgid "The file contains no readable audio samples."
msgstr "Die Datei enthält keine lesbaren Audiosamples."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:225
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:154
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:188
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1110
msgid "Generating waveform..."
msgstr "Wellenform wird erstellt…"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:233
msgid "FFmpeg is not installed."
msgstr "FFmpeg ist nicht installiert."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:280
msgid "The waveform could not be generated."
msgstr "Die Wellenform konnte nicht erstellt werden."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:288
msgid "The source changed while its waveform was being generated."
msgstr "Die Quelldatei hat sich während der Erstellung ihrer Wellenform geändert."

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:36
msgid "Check conversion settings"
msgstr "Konvertierungseinstellungen prüfen"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:47
msgid "Conversion could not start"
msgstr "Konvertierung konnte nicht gestartet werden"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:55
msgid "Converting audio"
msgstr "Audio wird konvertiert"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:72
#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:662
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1129
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1153
#: usr/share/biglinux/audio-converter/app/ui/pause_panel.py:82
#: usr/share/biglinux/audio-converter/app/ui/waveform_segments.py:156
#: usr/share/biglinux/audio-converter/app/ui/waveform_segments.py:187
msgid "Cancel"
msgstr "Abbrechen"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:85
msgid "Cancelling…"
msgstr "Abbruch läuft…"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:101
#, python-brace-format
msgid "Converting {current} of {total} · {percent}%"
msgstr "{current} von {total} wird konvertiert · {percent} %"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:135
#, python-brace-format
msgid "{count} file was not converted"
msgid_plural "{count} files were not converted"
msgstr[0] "{count} Datei wurde nicht konvertiert"
msgstr[1] "{count} Dateien wurden nicht konvertiert"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:139
#: usr/share/biglinux/audio-converter/app/ui/pause_panel.py:83
msgid "Try Again"
msgstr "Erneut versuchen"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:142
#, python-brace-format
msgid "{count} file converted"
msgid_plural "{count} files converted"
msgstr[0] "{count} Datei konvertiert"
msgstr[1] "{count} Dateien konvertiert"

#: usr/share/biglinux/audio-converter/app/ui/batch_runner.py:144
msgid "Show Files"
msgstr "Dateien anzeigen"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:51
msgid "Voice only"
msgstr "Nur Sprache"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:52
msgid "Fair"
msgstr "Ausreichend"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:53
msgid "Good"
msgstr "Gut"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:54
msgid "Very good"
msgstr "Sehr gut"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:55
msgid "Best"
msgstr "Maximal"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:66
#, python-brace-format
msgid "{quality}, about {size} MB per minute"
msgstr "{quality}, ca. {size} MB pro Minute"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:92
msgid "Allow conversion to 24-bit PCM"
msgstr "Konvertierung in 24-Bit-PCM zulassen"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:94
msgid "For floating-point audio exported to FLAC. Reduces precision; WAV preserves the original representation."
msgstr "Für Gleitkomma-Audio beim FLAC-Export. Verringert die Genauigkeit; WAV erhält die ursprüngliche Darstellung."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:116
#: usr/share/biglinux/audio-converter/app/ui/file_info.py:119
msgid "Format"
msgstr "Format"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:117
msgid "The type of file to save. Keeping the original applies no effects."
msgstr "Die Art der gespeicherten Datei. Beim Original werden keine Effekte angewendet."

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:119
msgid "MP3 — plays everywhere"
msgstr "MP3 — läuft überall"

#: usr/share/biglinux/audio-converter/app/ui/conversion_settings.py:120
