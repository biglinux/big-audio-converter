#: usr/share/biglinux/audio-converter/main.py:86
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1325
msgid "Local files only"
msgstr "Μόνο τοπικά αρχεία"

#: usr/share/biglinux/audio-converter/main.py:87
msgid "Download this file to a local folder before adding it."
msgstr "Κατεβάστε αυτό το αρχείο σε έναν τοπικό φάκελο πριν το προσθέσετε."

#: usr/share/biglinux/audio-converter/main.py:191
#: usr/share/biglinux/audio-converter/main.py:215
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:213
msgid "Audio Converter"
msgstr "Μετατροπέας ήχου"

#: usr/share/biglinux/audio-converter/main.py:193
#: usr/share/biglinux/audio-converter/main.py:195
msgid "BigLinux Team"
msgstr "Ομάδα BigLinux"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:62
msgid "The application is closing."
msgstr "Η εφαρμογή κλείνει."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:66
msgid "A conversion is still running. Wait for it to finish cancelling before starting another."
msgstr "Μια μετατροπή εξακολουθεί να εκτελείται. Περιμένετε να ολοκληρωθεί η ακύρωσή της πριν ξεκινήσετε άλλη."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:120
msgid "Conversion cancelled."
msgstr "Η μετατροπή ακυρώθηκε."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:142
msgid "The output path is invalid. Check the source filename and destination."
msgstr "Η διαδρομή εξόδου δεν είναι έγκυρη. Ελέγξτε το όνομα του αρχείου προέλευσης και τον προορισμό."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:171
#, python-brace-format
msgid "Joined into {name}"
msgstr "Ενώθηκε στο {name}"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:186
msgid "An unexpected error stopped this conversion."
msgstr "Ένα απρόσμενο σφάλμα σταμάτησε αυτή τη μετατροπή."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:228
msgid "The length of this file is unknown, so marked parts cannot be removed. Keep them instead."
msgstr "Η διάρκεια αυτού του αρχείου είναι άγνωστη, οπότε τα επισημασμένα μέρη δεν μπορούν να αφαιρεθούν. Επιλέξτε «Διατήρηση»."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:240
msgid "Every part of this file is marked for removal."
msgstr "Όλα τα μέρη αυτού του αρχείου έχουν επισημανθεί για αφαίρεση."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:256
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr "Το FFmpeg δεν είναι εγκατεστημένο. Εγκαταστήστε το πακέτο FFmpeg και δοκιμάστε ξανά."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:271
msgid "Fast Copy cannot join files. Select an audio format."
msgstr "Η γρήγορη αντιγραφή δεν μπορεί να ενώσει αρχεία. Επιλέξτε μια μορφή ήχου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:281
msgid "Files with more than two channels can only be joined as mono or stereo. Choose the channels in Advanced encoding."
msgstr "Τα αρχεία με περισσότερα από δύο κανάλια μπορούν να ενωθούν μόνο ως μονοφωνικά ή στερεοφωνικά. Επιλέξτε τα κανάλια στη «Σύνθετη κωδικοποίηση»."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:304
msgid "Fast Copy cannot apply effects, change channels or resample. Select an encoding format."
msgstr "Η γρήγορη αντιγραφή δεν μπορεί να εφαρμόσει εφέ, να αλλάξει κανάλια ή να κάνει επαναδειγματοληψία. Επιλέξτε μια μορφή κωδικοποίησης."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:315
msgid "Fast Copy preserves encoded audio packets; cut boundaries are approximate. Effects are not applied."
msgstr "Η γρήγορη αντιγραφή διατηρεί τα κωδικοποιημένα πακέτα ήχου· τα όρια κοπής είναι κατά προσέγγιση. Δεν εφαρμόζονται εφέ."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:334
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "Ο ήχος κινητής υποδιαστολής μετατράπηκε με ρητή άδεια σε ακέραιο PCM 24 bit για FLAC· δεν πρόκειται για αντίγραφο ταυτόσημο σε επίπεδο bit."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:340
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Το Opus χρησιμοποιεί ρολόι δειγματοληψίας αναπαραγωγής 48 kHz. Ο αρχικός ρυθμός δειγματοληψίας δεν μπορεί να αναπαρασταθεί αμετάβλητος στον περιέκτη εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:347
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "Ο κωδικοποιητής εξόδου απαιτεί επαναδειγματοληψία από {rate} Hz σε {final_rate} Hz."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:362
msgid "Positive gain may clip. Enable clipping protection or reduce the gain."
msgstr "Η θετική ενίσχυση μπορεί να προκαλέσει ψαλιδισμό. Ενεργοποιήστε την προστασία από ψαλιδισμό ή μειώστε την ενίσχυση."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:368
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "Αυτή η μορφή ακατέργαστου ήχου δεν μπορεί να διατηρήσει όλες τις ετικέτες ή τα εξώφυλλα."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:375
msgid "Artwork is not preserved by this output profile."
msgstr "Αυτό το προφίλ εξόδου δεν διατηρεί εξώφυλλα."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:443
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "Το αρχείο προέλευσης άλλαξε κατά τη μετατροπή. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου· προσθέστε το αρχείο ξανά."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:461
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Η μετατροπή ακυρώθηκε. Δεν αποθηκεύτηκε κανένα ημιτελές αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:475
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "Δεν ήταν δυνατή η πρόσβαση στο αρχείο ή στον προορισμό. Ελέγξτε τα δικαιώματα και τον ελεύθερο χώρο στον δίσκο."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:484
msgid "The media information or conversion settings are invalid."
msgstr "Οι πληροφορίες πολυμέσων ή οι ρυθμίσεις μετατροπής δεν είναι έγκυρες."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:501
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "Ο κωδικοποιητής άλλαξε τον ζητούμενο ρυθμό δειγματοληψίας. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:509
msgid "The encoder changed the requested channel count. No output was published."
msgstr "Ο κωδικοποιητής άλλαξε τον ζητούμενο αριθμό καναλιών. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:517
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "Αυτή η έκδοση του FFmpeg δεν μπορεί να διατηρήσει τη ζητούμενη ακρίβεια FLAC. Επιλέξτε WAV ή εγκαταστήστε ένα συμβατό πακέτο FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:538
#: usr/share/biglinux/audio-converter/app/audio/profiles.py:172
msgid "Select a supported output format."
msgstr "Επιλέξτε μια υποστηριζόμενη μορφή εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "Επιλέξτε ένα έγκυρο τοπικό αρχείο πολυμέσων."

#: usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "Το αρχείο προέλευσης λείπει ή δεν είναι κανονικό αρχείο."

#: usr/share/biglinux/audio-converter/app/audio/media.py:39
msgid "The selected audio track is invalid. Add the file again."
msgstr "Το επιλεγμένο κομμάτι ήχου δεν είναι έγκυρο. Προσθέστε το αρχείο ξανά."

#: usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "Το βίντεο προέλευσης λείπει. Προσθέστε το αρχείο ξανά."

#: usr/share/biglinux/audio-converter/app/audio/media.py:77
msgid "A segment has invalid start or end times."
msgstr "Ένα τμήμα έχει μη έγκυρο χρόνο έναρξης ή λήξης."

#: usr/share/biglinux/audio-converter/app/audio/media.py:82
msgid "Every segment must have a finite end time after its start."
msgstr "Κάθε τμήμα πρέπει να έχει πεπερασμένο χρόνο λήξης μετά την έναρξή του."

#: usr/share/biglinux/audio-converter/app/audio/media.py:91
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "Ένα τμήμα εκτείνεται πέρα από τον ήχο προέλευσης. Προσαρμόστε τον χρόνο λήξης του."

#: usr/share/biglinux/audio-converter/app/audio/media.py:97
msgid "A segment must contain at least one audio sample."
msgstr "Ένα τμήμα πρέπει να περιέχει τουλάχιστον ένα δείγμα ήχου."

#: usr/share/biglinux/audio-converter/app/audio/media.py:183
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr "Το FFprobe δεν είναι εγκατεστημένο. Εγκαταστήστε το πακέτο FFmpeg και δοκιμάστε ξανά."

#: usr/share/biglinux/audio-converter/app/audio/media.py:210
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr "Δεν ήταν δυνατή η ανάγνωση του αρχείου πολυμέσων. Ενδέχεται να είναι κατεστραμμένο ή μη υποστηριζόμενο."

#: usr/share/biglinux/audio-converter/app/audio/media.py:218
msgid "FFprobe returned invalid media information."
msgstr "Το FFprobe επέστρεψε μη έγκυρες πληροφορίες πολυμέσων."

#: usr/share/biglinux/audio-converter/app/audio/media.py:223
msgid "FFprobe returned incomplete media information."
msgstr "Το FFprobe επέστρεψε ελλιπείς πληροφορίες πολυμέσων."

#: usr/share/biglinux/audio-converter/app/audio/media.py:236
msgid "This file does not contain the selected audio track."
msgstr "Αυτό το αρχείο δεν περιέχει το επιλεγμένο κομμάτι ήχου."

#: usr/share/biglinux/audio-converter/app/audio/media.py:281
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr "Ο επιλεγμένος κωδικοποιητής WAV δεν μπορεί να διατηρήσει αυτή την ακρίβεια PCM."

#: usr/share/biglinux/audio-converter/app/audio/player.py:157
msgid "Audio preview is unavailable. Install mpv and python-mpv, then reopen the application."
msgstr "Η προακρόαση ήχου δεν είναι διαθέσιμη. Εγκαταστήστε τα mpv και python-mpv και ανοίξτε ξανά την εφαρμογή."

#: usr/share/biglinux/audio-converter/app/audio/player.py:184
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr "Δεν ήταν δυνατή η απαρίθμηση των εξόδων ήχου. Δοκιμάστε να ανοίξετε ξανά τον επιλογέα εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/player.py:206
msgid "The selected audio output was disconnected. Playback is paused. Choose an output or resume using the system default."
msgstr "Η επιλεγμένη έξοδος ήχου αποσυνδέθηκε. Η αναπαραγωγή έχει τεθεί σε παύση. Επιλέξτε μια έξοδο ή συνεχίστε με την προεπιλογή του συστήματος."

#: usr/share/biglinux/audio-converter/app/audio/player.py:219
msgid "This audio output is no longer available. Choose another output."
msgstr "Αυτή η έξοδος ήχου δεν είναι πλέον διαθέσιμη. Επιλέξτε άλλη έξοδο."

#: usr/share/biglinux/audio-converter/app/audio/player.py:231
msgid "The audio output could not be selected. Choose another output."
msgstr "Δεν ήταν δυνατή η επιλογή της εξόδου ήχου. Επιλέξτε άλλη έξοδο."

#: usr/share/biglinux/audio-converter/app/audio/player.py:257
msgid "The selected audio track is unavailable. Add the file again."
msgstr "Το επιλεγμένο κομμάτι ήχου δεν είναι διαθέσιμο. Προσθέστε το αρχείο ξανά."

#: usr/share/biglinux/audio-converter/app/audio/player.py:289
msgid "The audio could not be played. Check the file and audio output device."
msgstr "Δεν ήταν δυνατή η αναπαραγωγή του ήχου. Ελέγξτε το αρχείο και τη συσκευή εξόδου ήχου."

#: usr/share/biglinux/audio-converter/app/audio/player.py:415
msgid "This audio position could not be reached."
msgstr "Δεν ήταν δυνατή η μετάβαση σε αυτή τη θέση του ήχου."

#: usr/share/biglinux/audio-converter/app/audio/player.py:467
msgid "A preview effect could not be applied. Check the selected effects and installed plugins."
msgstr "Δεν ήταν δυνατή η εφαρμογή ενός εφέ προακρόασης. Ελέγξτε τα επιλεγμένα εφέ και τα εγκατεστημένα πρόσθετα."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:59
msgid "Too many files are waiting for inspection. Wait for some files to finish, then add more."
msgstr "Πάρα πολλά αρχεία περιμένουν ανάλυση. Περιμένετε να ολοκληρωθεί η ανάλυση ορισμένων αρχείων και μετά προσθέστε περισσότερα."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:80
msgid "Select a regular local media file, not a folder or device."
msgstr "Επιλέξτε ένα κανονικό τοπικό αρχείο πολυμέσων, όχι φάκελο ή συσκευή."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:100
msgid "The file changed during inspection. Add it again."
msgstr "Το αρχείο άλλαξε κατά την ανάλυση. Προσθέστε το ξανά."

#: usr/share/biglinux/audio-converter/app/audio/process.py:116
#: usr/share/biglinux/audio-converter/app/audio/process.py:144
msgid "The media command timed out."
msgstr "Έληξε το χρονικό όριο της εντολής πολυμέσων."

#: usr/share/biglinux/audio-converter/app/audio/process.py:134
msgid "The media information is too large to process safely."
msgstr "Οι πληροφορίες πολυμέσων είναι υπερβολικά μεγάλες για ασφαλή επεξεργασία."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:130
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Μη έγκυρη τιμή για το {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:134
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "Η τιμή του {key} πρέπει να είναι μεταξύ {low} και {high}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:142
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Μη έγκυρη τιμή διακόπτη για το {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:152
msgid "The equalizer bands are invalid."
msgstr "Οι ζώνες του ισοσταθμιστή δεν είναι έγκυρες."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:159
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "Ο ισοσταθμιστής χρειάζεται δέκα πεπερασμένες τιμές ενίσχυσης μεταξύ -40 και 40 dB."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:163
msgid "Select a supported noise reduction mode."
msgstr "Επιλέξτε μια υποστηριζόμενη λειτουργία μείωσης θορύβου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:188
msgid "FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow conversion to 24-bit PCM in Advanced encoding."
msgstr "Το FLAC δεν μπορεί να διατηρήσει αυτή την αναπαράσταση PCM. Επιλέξτε WAV ή επιτρέψτε ρητά τη μετατροπή σε PCM 24 bit στη σύνθετη κωδικοποίηση."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:213
msgid "The selected bitrate is not supported by this output profile."
msgstr "Ο επιλεγμένος ρυθμός μετάδοσης bit δεν υποστηρίζεται από αυτό το προφίλ εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:220
msgid "Select original, mono or stereo channels."
msgstr "Επιλέξτε αρχικά, μονοφωνικά ή στερεοφωνικά κανάλια."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:228
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "Το MP3 υποστηρίζει μονοφωνικό ή στερεοφωνικό ήχο. Επιλέξτε στερεοφωνικά κανάλια ή άλλη μορφή."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:235
msgid "Select a valid output sample rate."
msgstr "Επιλέξτε έναν έγκυρο ρυθμό δειγματοληψίας εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:242
msgid "The selected codec does not support that sample rate."
msgstr "Ο επιλεγμένος κωδικοποιητής δεν υποστηρίζει αυτόν τον ρυθμό δειγματοληψίας."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:316
msgid "The selected noise reduction plugin is unavailable. Install it or turn noise reduction off."
msgstr "Το επιλεγμένο πρόσθετο μείωσης θορύβου δεν είναι διαθέσιμο. Εγκαταστήστε το ή απενεργοποιήστε τη μείωση θορύβου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:350
msgid "The audio plugin path is unsupported."
msgstr "Η διαδρομή του πρόσθετου ήχου δεν υποστηρίζεται."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:40
msgid "There is not enough free disk space. Free some space and try again."
msgstr "Δεν υπάρχει αρκετός ελεύθερος χώρος στον δίσκο. Ελευθερώστε χώρο και δοκιμάστε ξανά."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:47
msgid "The file or destination is not accessible. Check its permissions."
msgstr "Το αρχείο ή ο προορισμός δεν είναι προσβάσιμος. Ελέγξτε τα δικαιώματα πρόσβασης."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:54
msgid "The required audio encoder is unavailable. Install a compatible FFmpeg package."
msgstr "Ο απαιτούμενος κωδικοποιητής ήχου δεν είναι διαθέσιμος. Εγκαταστήστε ένα συμβατό πακέτο FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:61
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "Ένα επιλεγμένο εφέ ήχου δεν είναι διαθέσιμο σε αυτή την εγκατάσταση του FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:67
msgid "The audio could not be processed. Check the file and selected output settings."
msgstr "Δεν ήταν δυνατή η επεξεργασία του ήχου. Ελέγξτε το αρχείο και τις επιλεγμένες ρυθμίσεις εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:164
msgid "Effects require re-encoding. Select an audio format instead of Fast Copy."
msgstr "Τα εφέ απαιτούν επανακωδικοποίηση. Επιλέξτε μια μορφή ήχου αντί για γρήγορη αντιγραφή."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:320
msgid "An intermediate segment has an unsafe path."
msgstr "Ένα ενδιάμεσο τμήμα έχει μη ασφαλή διαδρομή."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:403
msgid "The output contains no readable audio. No file was published."
msgstr "Η έξοδος δεν περιέχει αναγνώσιμο ήχο. Δεν αποθηκεύτηκε τελικό αρχείο."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:56
msgid "The audio contains non-finite samples."
msgstr "Ο ήχος περιέχει δείγματα με μη πεπερασμένες τιμές."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:98
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "Ο αποκωδικοποιημένος ήχος τελειώνει με ελλιπές πλαίσιο δειγμάτων."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:101
msgid "The file contains no readable audio samples."
msgstr "Το αρχείο δεν περιέχει αναγνώσιμα δείγματα ήχου."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:233
