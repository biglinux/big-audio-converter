#: usr/share/biglinux/audio-converter/main.py:92
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1268
msgid "Local files only"
msgstr "Μόνο τοπικά αρχεία"

#: usr/share/biglinux/audio-converter/main.py:93
#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:1069
msgid "Download this file to a local folder before adding it."
msgstr "Κατεβάστε αυτό το αρχείο σε έναν τοπικό φάκελο πριν το προσθέσετε."

#: usr/share/biglinux/audio-converter/main.py:201
#: usr/share/biglinux/audio-converter/main.py:203
msgid "BigLinux Team"
msgstr "Ομάδα BigLinux"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:48
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:59
msgid "Clear queue"
msgstr "Εκκαθάριση ουράς"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:62
msgid "0 files"
msgstr "0 αρχεία"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:71
msgid "Show help on hover"
msgstr "Εμφάνιση βοήθειας κατά την κατάδειξη"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:72
msgid "Show Welcome Screen"
msgstr "Εμφάνιση οθόνης καλωσορίσματος"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:74
msgid "Reset All Settings…"
msgstr "Επαναφορά όλων των ρυθμίσεων…"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:77
msgid "About"
msgstr "Σχετικά"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:82
msgid "Main menu"
msgstr "Κύριο μενού"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:111
msgid "Add Files"
msgstr "Προσθήκη αρχείων"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:118
msgid "Convert"
msgstr "Μετατροπή"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:230
msgid "Settings could not be read and were reset"
msgstr "Δεν ήταν δυνατή η ανάγνωση των ρυθμίσεων και έγινε επαναφορά τους"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:445
msgid "Selection only"
msgstr "Μόνο η επιλογή"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:456
msgid "Play only selected area"
msgstr "Αναπαραγωγή μόνο της επιλεγμένης περιοχής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:462
msgid "Edit Segments…"
msgstr "Επεξεργασία τμημάτων…"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:472
msgid "Play the next file automatically"
msgstr "Αυτόματη αναπαραγωγή του επόμενου αρχείου"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:491
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:502
#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:169
#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:308
msgid "Equalizer"
msgstr "Ισοσταθμιστής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:506
msgid "Listen to original"
msgstr "Ακρόαση πρωτοτύπου"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:508
msgid "Temporarily listen without effects. Export settings stay unchanged."
msgstr "Προσωρινή ακρόαση χωρίς εφέ. Οι ρυθμίσεις εξαγωγής παραμένουν αμετάβλητες."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:522
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:524
msgid "More playback options"
msgstr "Περισσότερες επιλογές αναπαραγωγής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:528
msgid "Playback"
msgstr "Αναπαραγωγή"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:529
msgid "Only affects listening. Converted files stay unchanged."
msgstr "Επηρεάζει μόνο την ακρόαση. Τα αρχεία που μετατράπηκαν παραμένουν αμετάβλητα."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:537
msgid "Audio output"
msgstr "Έξοδος ήχου"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:537
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:860
msgid "System default"
msgstr "Προεπιλογή συστήματος"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:545
msgid "Refresh audio outputs"
msgstr "Ανανέωση εξόδων ήχου"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:574
msgid "Previous track"
msgstr "Προηγούμενο κομμάτι"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:590
msgid "Play or pause"
msgstr "Αναπαραγωγή ή παύση"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:604
msgid "Next track"
msgstr "Επόμενο κομμάτι"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:629
msgid "Volume"
msgstr "Ένταση"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:651
msgid "Speed"
msgstr "Ταχύτητα"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:662
#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:381
msgid "Clean voice"
msgstr "Καθαρισμός φωνής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:664
msgid "Highlights the voice and reduces other sounds. At 100%, it applies the model's maximum reduction."
msgstr "Αναδεικνύει τη φωνή και μειώνει τους άλλους ήχους. Στο 100% εφαρμόζει τη μέγιστη μείωση του μοντέλου."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:684
msgid "Waveform zoom"
msgstr "Μεγέθυνση κυματομορφής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:793
#, python-format
msgid "Join %d file"
msgid_plural "Join %d files"
msgstr[0] "Ένωση %d αρχείου"
msgstr[1] "Ένωση %d αρχείων"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:795
#, python-format
msgid "Convert %d file"
msgid_plural "Convert %d files"
msgstr[0] "Μετατροπή %d αρχείου"
msgstr[1] "Μετατροπή %d αρχείων"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:975
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1094
msgid "OK"
msgstr "Εντάξει"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:983
msgid "Stop the conversion?"
msgstr "Διακοπή της μετατροπής;"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:985
msgid "Closing the window stops the conversion in progress. Files that already finished are kept."
msgstr "Το κλείσιμο του παραθύρου διακόπτει τη μετατροπή σε εξέλιξη. Τα αρχεία που έχουν ήδη ολοκληρωθεί διατηρούνται."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:989
msgid "Keep Converting"
msgstr "Συνέχεια μετατροπής"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:990
msgid "Stop and Close"
msgstr "Διακοπή και κλείσιμο"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1041
msgid "No audio selected"
msgstr "Δεν έχει επιλεγεί ήχος"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1042
msgid "Add a file and select it before editing segments."
msgstr "Προσθέστε και επιλέξτε ένα αρχείο πριν επεξεργαστείτε τμήματα."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1047
msgid "Audio duration unavailable"
msgstr "Η διάρκεια του ήχου δεν είναι διαθέσιμη"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1048
msgid "Wait for the waveform to finish loading before editing this file."
msgstr "Περιμένετε να φορτωθεί η κυματομορφή πριν επεξεργαστείτε αυτό το αρχείο."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1088
msgid "Other valid files remain in the queue. Check these files and add them again."
msgstr "Τα υπόλοιπα έγκυρα αρχεία παραμένουν στην ουρά. Ελέγξτε αυτά τα αρχεία και προσθέστε τα ξανά."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1092
msgid "Some files could not be added"
msgstr "Δεν ήταν δυνατή η προσθήκη ορισμένων αρχείων"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1108
msgid "Audio preview"
msgstr "Προακρόαση ήχου"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1136
msgid "Reset all settings?"
msgstr "Επαναφορά όλων των ρυθμίσεων;"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1138
msgid "Format, quality, output folder, cutting, effects and equalizer return to their defaults. The queue and your source files are kept."
msgstr "Η μορφή, η ποιότητα, ο φάκελος εξόδου, η κοπή, τα εφέ και ο ισοσταθμιστής επιστρέφουν στις προεπιλογές. Η ουρά και τα αρχεία προέλευσης διατηρούνται."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1142
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1161
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:82
#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:865
#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:163
#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:194
#: usr/share/biglinux/audio-converter/app/ui/pause_popover.py:94
msgid "Cancel"
msgstr "Ακύρωση"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1143
msgid "Reset"
msgstr "Επαναφορά"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1156
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1162
msgid "Clear Queue"
msgstr "Εκκαθάριση ουράς"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1158
msgid "Remove the queue entries and their edits? Source files will not be deleted."
msgstr "Να αφαιρεθούν οι καταχωρίσεις της ουράς και οι επεξεργασίες τους; Τα αρχεία προέλευσης δεν θα διαγραφούν."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1194
msgid "Select Audio or Video Files"
msgstr "Επιλογή αρχείων ήχου ή βίντεο"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1197
msgid "Audio and Video files"
msgstr "Αρχεία ήχου και βίντεο"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1243
msgid "All files"
msgstr "Όλα τα αρχεία"

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1270
msgid "Some selected files are remote. Download them before adding them."
msgstr "Ορισμένα επιλεγμένα αρχεία είναι απομακρυσμένα. Κατεβάστε τα πριν τα προσθέσετε."

#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1281
msgid "Files could not be selected"
msgstr "Δεν ήταν δυνατή η επιλογή αρχείων"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:63
msgid "The application is closing."
msgstr "Η εφαρμογή κλείνει."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:67
msgid "A conversion is still running. Wait for it to finish cancelling before starting another."
msgstr "Μια μετατροπή εξακολουθεί να εκτελείται. Περιμένετε να ολοκληρωθεί η ακύρωσή της πριν ξεκινήσετε άλλη."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:121
msgid "Conversion cancelled."
msgstr "Η μετατροπή ακυρώθηκε."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:143
msgid "The output path is invalid. Check the source filename and destination."
msgstr "Η διαδρομή εξόδου δεν είναι έγκυρη. Ελέγξτε το όνομα του αρχείου προέλευσης και τον προορισμό."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:172
#, python-brace-format
msgid "Joined into {name}"
msgstr "Ενώθηκε στο {name}"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:187
msgid "An unexpected error stopped this conversion."
msgstr "Ένα απρόσμενο σφάλμα σταμάτησε αυτή τη μετατροπή."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:227
msgid "The length of this file is unknown, so marked parts cannot be removed. Keep them instead."
msgstr "Η διάρκεια αυτού του αρχείου είναι άγνωστη, οπότε τα επισημασμένα μέρη δεν μπορούν να αφαιρεθούν. Επιλέξτε «Διατήρηση»."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:238
msgid "Every part of this file is marked for removal."
msgstr "Όλα τα μέρη αυτού του αρχείου έχουν επισημανθεί για αφαίρεση."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:253
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr "Το FFmpeg δεν είναι εγκατεστημένο. Εγκαταστήστε το πακέτο FFmpeg και δοκιμάστε ξανά."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:268
msgid "Keeping the original format cannot join files. Select an audio format."
msgstr "Με διατήρηση της αρχικής μορφής δεν γίνεται ένωση αρχείων. Επιλέξτε μορφή ήχου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:278
msgid "Files with more than two channels can only be joined as mono or stereo. Choose the channels in Advanced encoding."
msgstr "Τα αρχεία με περισσότερα από δύο κανάλια μπορούν να ενωθούν μόνο ως μονοφωνικά ή στερεοφωνικά. Επιλέξτε τα κανάλια στη «Σύνθετη κωδικοποίηση»."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:301
msgid "Keeping the original format cannot apply effects, change channels or resample. Select an audio format."
msgstr "Με διατήρηση της αρχικής μορφής δεν εφαρμόζονται εφέ, δεν αλλάζουν κανάλια και δεν γίνεται επαναδειγματοληψία. Επιλέξτε μορφή ήχου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:312
msgid "The original format keeps the encoded audio, so cuts are approximate and effects are not applied."
msgstr "Η αρχική μορφή διατηρεί τον κωδικοποιημένο ήχο, οπότε οι περικοπές είναι κατά προσέγγιση και τα εφέ δεν εφαρμόζονται."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:331
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "Ο ήχος κινητής υποδιαστολής μετατράπηκε με ρητή άδεια σε ακέραιο PCM 24 bit για FLAC· δεν πρόκειται για αντίγραφο ταυτόσημο σε επίπεδο bit."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:337
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Το Opus χρησιμοποιεί ρολόι δειγματοληψίας αναπαραγωγής 48 kHz. Ο αρχικός ρυθμός δειγματοληψίας δεν μπορεί να αναπαρασταθεί αμετάβλητος στον περιέκτη εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:344
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "Ο κωδικοποιητής εξόδου απαιτεί επαναδειγματοληψία από {rate} Hz σε {final_rate} Hz."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:359
msgid "Raising the volume may distort. Turn on Prevent distortion or lower the volume."
msgstr "Η αύξηση της έντασης μπορεί να προκαλέσει παραμόρφωση. Ενεργοποιήστε την Αποτροπή παραμόρφωσης ή χαμηλώστε την ένταση."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:365
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "Αυτή η μορφή ακατέργαστου ήχου δεν μπορεί να διατηρήσει όλες τις ετικέτες ή τα εξώφυλλα."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:372
msgid "Artwork is not preserved by this output profile."
msgstr "Αυτό το προφίλ εξόδου δεν διατηρεί εξώφυλλα."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:438
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "Το αρχείο προέλευσης άλλαξε κατά τη μετατροπή. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου· προσθέστε το αρχείο ξανά."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:456
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Η μετατροπή ακυρώθηκε. Δεν αποθηκεύτηκε κανένα ημιτελές αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:470
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "Δεν ήταν δυνατή η πρόσβαση στο αρχείο ή στον προορισμό. Ελέγξτε τα δικαιώματα και τον ελεύθερο χώρο στον δίσκο."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:479
msgid "The media information or conversion settings are invalid."
msgstr "Οι πληροφορίες πολυμέσων ή οι ρυθμίσεις μετατροπής δεν είναι έγκυρες."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:496
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "Ο κωδικοποιητής άλλαξε τον ζητούμενο ρυθμό δειγματοληψίας. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:504
msgid "The encoder changed the requested channel count. No output was published."
msgstr "Ο κωδικοποιητής άλλαξε τον ζητούμενο αριθμό καναλιών. Δεν αποθηκεύτηκε τελικό αρχείο εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:512
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "Αυτή η έκδοση του FFmpeg δεν μπορεί να διατηρήσει τη ζητούμενη ακρίβεια FLAC. Επιλέξτε WAV ή εγκαταστήστε ένα συμβατό πακέτο FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:530
#: usr/share/biglinux/audio-converter/app/audio/profiles.py:173
msgid "Select a supported output format."
msgstr "Επιλέξτε μια υποστηριζόμενη μορφή εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:131
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Μη έγκυρη τιμή για το {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:135
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "Η τιμή του {key} πρέπει να είναι μεταξύ {low} και {high}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:143
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Μη έγκυρη τιμή διακόπτη για το {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:153
msgid "The equalizer bands are invalid."
msgstr "Οι ζώνες του ισοσταθμιστή δεν είναι έγκυρες."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:160
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "Ο ισοσταθμιστής χρειάζεται δέκα πεπερασμένες τιμές ενίσχυσης μεταξύ -40 και 40 dB."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:164
msgid "Select a supported noise reduction mode."
msgstr "Επιλέξτε μια υποστηριζόμενη λειτουργία μείωσης θορύβου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:189
msgid "FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow conversion to 24-bit PCM in Advanced encoding."
msgstr "Το FLAC δεν μπορεί να διατηρήσει αυτή την αναπαράσταση PCM. Επιλέξτε WAV ή επιτρέψτε ρητά τη μετατροπή σε PCM 24 bit στη σύνθετη κωδικοποίηση."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:214
msgid "The selected bitrate is not supported by this output profile."
msgstr "Ο επιλεγμένος ρυθμός μετάδοσης bit δεν υποστηρίζεται από αυτό το προφίλ εξόδου."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:221
msgid "Select original, mono or stereo channels."
msgstr "Επιλέξτε αρχικά, μονοφωνικά ή στερεοφωνικά κανάλια."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:229
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
