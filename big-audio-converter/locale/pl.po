msgstr "Intensywność"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:388
msgid "Remove low rumble"
msgstr "Usuń niskie dudnienie"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:389
