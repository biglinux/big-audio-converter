msgstr "Chroni głośne szczyty przed przesterowaniem"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:416
msgid "Advanced encoding"
msgstr "Zaawansowane kodowanie"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:417
