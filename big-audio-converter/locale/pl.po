msgid "Local files only"
msgstr "Tylko pliki lokalne"

#: usr/share/biglinux/audio-converter/main.py:87
msgid "Download this file to a local folder before adding it."
msgstr "Przed dodaniem pobierz ten plik do lokalnego folderu."

#: usr/share/biglinux/audio-converter/main.py:216
#: usr/share/biglinux/audio-converter/main.py:192
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:213
msgid "Audio Converter"
msgstr "Konwerter dźwięku"

#: usr/share/biglinux/audio-converter/main.py:194
#: usr/share/biglinux/audio-converter/main.py:196
msgid "BigLinux Team"
msgstr "Zespół BigLinux"

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:9
msgid "Choose the output format. Fast Copy does not apply effects."
msgstr "Wybierz format wyjściowy. Szybkie kopiowanie nie stosuje efektów."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:10
msgid ""
"Higher values sound better and make larger files.\n"
"96k: speech, smallest files\n"
"128k: podcasts and audiobooks\n"
"192k: music, a good balance\n"
"320k: highest MP3 quality\n"
"Available values depend on the format."
msgstr ""
"Wyższe wartości zapewniają lepszy dźwięk i większe pliki.\n"
"96k: mowa, najmniejsze pliki\n"
"128k: podcasty i audiobooki\n"
"192k: muzyka, dobry kompromis\n"
"320k: najwyższa jakość MP3\n"
"Dostępne wartości zależą od formatu."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:18
#, no-python-format
msgid "Changes preview and export volume. Values above 100% can distort the audio."
msgstr "Zmienia głośność odsłuchu i eksportowanego dźwięku. Wartości powyżej 100% mogą powodować zniekształcenia."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:21
msgid "Changes preview and export speed while preserving pitch."
msgstr "Zmienia prędkość odsłuchu i eksportowanego dźwięku, zachowując wysokość tonu."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:22
msgid "Reduce noise in speech with DeepFilterNet3 or DPDFNet. Not intended for music."
msgstr "Redukuje szum w mowie za pomocą DeepFilterNet3 lub DPDFNet. Funkcja nie jest przeznaczona do muzyki."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:25
msgid "Reduce quiet background sound between spoken phrases."
msgstr "Ścisza ciche dźwięki tła między wypowiedziami."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:26
msgid "Adjust loudness to −16 LUFS. This changes the original volume."
msgstr "Dostosowuje głośność do −16 LUFS. Zmienia to oryginalną głośność."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:27
msgid "Choose the order in which marked segments are exported."
msgstr "Wybierz kolejność eksportowania zaznaczonych fragmentów."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:28
msgid "Export each segment separately or join the selected segments."
msgstr "Eksportuj każdy fragment osobno lub połącz wybrane fragmenty."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:29
msgid "Keep the original layout or explicitly downmix to mono or stereo."
msgstr "Zachowuje oryginalny układ kanałów lub na wyraźne żądanie miksuje dźwięk do mono albo stereo."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:30
msgid "Click the waveform to mark cuts, or drag markers to adjust them. Use the seek bar to preview. Edit Segments provides numeric and keyboard controls."
msgstr "Kliknij przebieg fali, aby zaznaczyć miejsca cięcia, lub przeciągnij znaczniki, aby je dopasować. Do odsłuchu użyj paska pozycji. Edytor fragmentów umożliwia wprowadzanie wartości liczbowych i obsługę klawiaturą."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:33
msgid "Remove all entries from the queue without deleting source files."
msgstr "Usuwa wszystkie pozycje z kolejki bez usuwania plików źródłowych."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:36
msgid "Preview the previous file."
msgstr "Odsłuchaj poprzedni plik."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:37
msgid "Play or pause. Keyboard shortcut: Ctrl+Space."
msgstr "Odtwórz lub wstrzymaj. Skrót klawiszowy: Ctrl+Space."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:38
msgid "Preview the next file."
msgstr "Odsłuchaj następny plik."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:39
msgid "Preview only the marked segments."
msgstr "Odsłuchaj tylko zaznaczone fragmenty."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:40
msgid "Preview the next track after the current track ends."
msgstr "Po zakończeniu bieżącej ścieżki odtwórz następną."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:41
msgid "Show the equalizer. Its settings affect exported audio."
msgstr "Pokaż korektor. Jego ustawienia wpływają na eksportowany dźwięk."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:42
msgid "Preview this audio file."
msgstr "Odsłuchaj ten plik dźwiękowy."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:43
msgid "Remove this entry without deleting the source file."
msgstr "Usuń tę pozycję bez usuwania pliku źródłowego."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:44
msgid "More actions are available from the adjacent menu button."
msgstr "Więcej działań jest dostępnych pod sąsiednim przyciskiem menu."

#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:192
msgid "Delete All Segments"
msgstr "Usuń wszystkie fragmenty"

#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:193
msgid "Delete all marked segments? Source files will not be changed."
msgstr "Usunąć wszystkie zaznaczone fragmenty? Pliki źródłowe nie zostaną zmienione."

