msgstr "Wycisza tło między słowami"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:369
msgid "Balance loud and quiet parts"
msgstr "Wyrównaj głośne i ciche partie"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:370
msgid "Brings quiet passages closer to the loud ones"
msgstr "Zbliża głośność cichych partii do głośnych"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:380
