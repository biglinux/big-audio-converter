#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:484
msgid "Choose output folder"
msgstr "Vælg outputmappe"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:335
#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:336
msgid "Use source folders"
msgstr "Brug kildemapper"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:346
msgid "Adjust sound"
msgstr "Juster lyden"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:351
msgid "Even volume"
msgstr "Ensartet lydstyrke"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:352
msgid "Brings every file to the same loudness (−16 LUFS)"
msgstr "Giver alle filer samme lydniveau (−16 LUFS)"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:361
msgid "Silence pauses"
msgstr "Dæmp pauser"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:362
msgid "Mutes the background between words"
msgstr "Gør baggrunden lydløs mellem ordene"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:369
msgid "Balance loud and quiet parts"
msgstr "Udjævn kraftige og svage passager"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:370
msgid "Brings quiet passages closer to the loud ones"
msgstr "Bringer svage passager tættere på de kraftige"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:380
msgid "Intensity"
msgstr "Intensitet"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:388
msgid "Remove low rumble"
msgstr "Fjern dyb rumlen"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:389
msgid "Cuts hum and handling noise below the voice"
msgstr "Fjerner brum og håndteringsstøj under stemmen"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:397
msgid "Frequency (Hz)"
msgstr "Frekvens (Hz)"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:407
msgid "Prevent distortion"
msgstr "Undgå forvrængning"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:408
msgid "Keeps loud peaks from clipping"
msgstr "Forhindrer, at kraftige toppe bliver overstyret"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:416
msgid "Advanced encoding"
msgstr "Avanceret kodning"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:417
msgid "Keep original properties when supported"
msgstr "Bevar de oprindelige egenskaber, når de understøttes"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:421
msgid "Mono"
msgstr "Mono"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:421
msgid "Stereo"
msgstr "Stereo"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:439
msgid "Allow conversion to 24-bit PCM"
msgstr "Tillad konvertering til 24-bit PCM"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:441
msgid "For floating-point audio exported to FLAC. Reduces precision; WAV preserves the original representation."
msgstr "Til flydende komma-lyd, der eksporteres til FLAC. Reducerer præcisionen; WAV bevarer den oprindelige repræsentation."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:458
msgid "Fast Copy keeps encoded audio. Cuts follow packet boundaries and may not match the exact times. Effects are bypassed in preview and export."
msgstr "Direkte kopiering bevarer den kodede lyd. Klip følger pakkegrænserne og svarer muligvis ikke til de nøjagtige tider. Effekter springes over ved forhåndslytning og eksport."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:469
msgid "Boosting volume or equalizer bands can distort audio. Reduce gain or enable clipping protection."
msgstr "Øget lydstyrke eller forstærkning af equalizerbånd kan forvrænge lyden. Reducer forstærkningen, eller aktivér beskyttelse mod overstyring."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:498
msgid "Local folder required"
msgstr "En lokal mappe er påkrævet"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:499
msgid "Choose a folder on the local filesystem."
msgstr "Vælg en mappe i det lokale filsystem."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:663
#, python-brace-format
msgid "Unavailable: install {package}"
msgstr "Utilgængelig: installér {package}"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:674
#, python-brace-format
msgid "Clean voice · {percent}%"
msgstr "Rens stemmen · {percent}%"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:676
msgid "Clean voice · off"
msgstr "Rens stemmen · fra"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:702
#, python-brace-format
msgid "Volume {percent}%"
msgstr "Lydstyrke {percent}%"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:704
#, python-brace-format
msgid "Speed {factor}×"
msgstr "Hastighed {factor}×"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:721
msgid "Volume, speed, equalizer and effects"
msgstr "Lydstyrke, hastighed, equalizer og effekter"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:52
msgid "Audio waveform visualizer"
msgstr "Visning af lydbølgeform"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1267
msgid "Waveform could not be generated"
msgstr "Bølgeformen kunne ikke genereres"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1268
msgid "Numeric segment editing is still available."
msgstr "Numerisk redigering af segmenter er stadig tilgængelig."

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1270
msgid "Waveform visualization disabled"
msgstr "Bølgeformsvisning deaktiveret"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1271
msgid "Enable in settings to see waveform"
msgstr "Aktivér i indstillingerne for at se bølgeformen"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1273
msgid "No audio loaded"
msgstr "Ingen lyd indlæst"

#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1395
msgid "Audio position seekbar"
msgstr "Positionslinje for lyd"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:19
msgid "Welcome"
msgstr "Velkommen"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:33
msgid "Convert audio in three steps"
msgstr "Konvertér lyd i tre trin"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:39
msgid "1. Add your files"
msgstr "1. Tilføj dine filer"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:40
msgid "Audio or video. Each audio track of a video becomes its own entry."
msgstr "Lyd eller video. Hvert lydspor i en video bliver til sit eget element."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:43
msgid "2. Choose what to make"
msgstr "2. Vælg, hvad du vil lave"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:45
msgid "Pick a format and, if you want, clean the voice, cut parts or adjust the sound."
msgstr "Vælg et format, og rens eventuelt stemmen, klip dele ud, eller juster lyden."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:49
msgid "3. Convert"
msgstr "3. Konvertér"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:50
msgid "New files appear next to the originals, which are never changed."
msgstr "Nye filer placeres ved siden af originalerne, som aldrig ændres."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:60
msgid "Show dialog on startup"
msgstr "Vis denne dialog ved opstart"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:71
msgid "Let's Start"
msgstr "Kom i gang"

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:9
msgid "Choose the output format. Fast Copy does not apply effects."
msgstr "Vælg outputformatet. Direkte kopiering anvender ikke effekter."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:11
msgid ""
"Higher values sound better and make larger files.\n"
"96k: speech, smallest files\n"
"128k: podcasts and audiobooks\n"
"192k: music, a good balance\n"
"320k: highest MP3 quality\n"
"Available values depend on the format."
msgstr ""
"Højere værdier giver bedre lyd og større filer.\n"
"96k: tale, de mindste filer\n"
"128k: podcasts og lydbøger\n"
"192k: musik, en god balance\n"
"320k: højeste MP3-kvalitet\n"
"De tilgængelige værdier afhænger af formatet."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:19
msgid "Changes preview and export volume. Values above 100% can distort the audio."
msgstr "Ændrer lydstyrken ved forhåndslytning og eksport. Værdier over 100% kan forvrænge lyden."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:21
msgid "Changes preview and export speed while preserving pitch."
msgstr "Ændrer hastigheden ved forhåndslytning og eksport uden at ændre tonehøjden."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:23
msgid "Reduce noise in speech with DeepFilterNet3 or DPDFNet. Not intended for music."
msgstr "Reducerer støj i tale med DeepFilterNet3 eller DPDFNet. Ikke beregnet til musik."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:25
msgid "Reduce quiet background sound between spoken phrases."
msgstr "Dæmper svage baggrundslyde mellem talte sætninger."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:26
msgid "Adjust loudness to −16 LUFS. This changes the original volume."
msgstr "Justerer lydstyrken til −16 LUFS. Dette ændrer den oprindelige lydstyrke."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:27
msgid "Choose the order in which marked segments are exported."
msgstr "Vælg den rækkefølge, de markerede segmenter eksporteres i."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:28
msgid "Export each segment separately or join the selected segments."
msgstr "Eksportér hvert segment separat, eller sammenføj de valgte segmenter."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:29
msgid "Keep the original layout or explicitly downmix to mono or stereo."
msgstr "Bevar den oprindelige kanalfordeling, eller miks ned til mono eller stereo."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:31
msgid "Click the waveform to mark cuts, or drag markers to adjust them. Use the seek bar to preview. Edit Segments provides numeric and keyboard controls."
msgstr "Klik på bølgeformen for at markere klip, eller træk i markørerne for at justere dem. Brug positionslinjen til at lytte. Rediger segmenter giver talfelter og tastaturbetjening."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:34
msgid "Remove all entries from the queue without deleting source files."
msgstr "Fjerner alle elementer fra køen uden at slette kildefilerne."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:36
msgid "Preview the previous file."
msgstr "Lyt til den forrige fil."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:37
msgid "Play or pause. Keyboard shortcut: Ctrl+Space."
msgstr "Afspil eller sæt på pause. Tastaturgenvej: Ctrl+Mellemrum."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:38
msgid "Preview the next file."
msgstr "Lyt til den næste fil."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:39
msgid "Preview only the marked segments."
msgstr "Lyt kun til de markerede segmenter."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:40
msgid "Show the equalizer. Its settings affect exported audio."
msgstr "Viser equalizeren. Dens indstillinger påvirker den eksporterede lyd."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:41
msgid "Preview this audio file."
msgstr "Lyt til denne lydfil."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:42
msgid "Remove this entry without deleting the source file."
msgstr "Fjerner dette element uden at slette kildefilen."

#: usr/share/biglinux/audio-converter/app/utils/tooltip_helper.py:44
msgid "More actions are available from the adjacent menu button."
msgstr "Menuknappen ved siden af giver adgang til flere handlinger."

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:24
msgid "Extract Audio"
msgstr "Udtræk lyd"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:24
msgid "Convert or Edit Audio"
msgstr "Konvertér eller rediger lyd"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:49
msgid "No local media files"
msgstr "Ingen lokale mediefiler"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:50
msgid "Download remote files before converting them."
msgstr "Download eksterne filer, før du konverterer dem."

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:68
msgid "Application Launch Error"
msgstr "Fejl ved programstart"

#: usr/share/nautilus-python/extensions/big_audio_converter_extension.py:70
msgid "Big Audio Converter could not be started. Check that it is installed."
msgstr "Big Audio Converter kunne ikke startes. Kontrollér, at programmet er installeret."
