#: usr/share/biglinux/audio-converter/app/audio/converter.py:227
msgid "Fast Copy preserves encoded audio packets; cut boundaries are approximate. Effects are not applied."
msgstr "快速复制会保留已编码的音频数据包；剪切边界为近似位置。不会应用音效。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:239
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "根据明确许可，浮点音频已转换为用于 FLAC 的 24 位整数 PCM；这不是逐位一致的副本。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:245
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Opus 使用 48 kHz 的播放采样时钟。无法在输出容器中原样表示源采样率。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:252
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "输出编解码器要求从 {rate} Hz 重采样为 {final_rate} Hz。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:267
msgid "Positive gain may clip. Enable clipping protection or reduce the gain."
msgstr "正增益可能导致削波。请启用削波保护或降低增益。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:273
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "这种原始音频格式无法保留所有标签或封面图。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:281
msgid "Artwork is not preserved by this output profile."
msgstr "此输出配置不会保留封面图。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:346
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "源文件在转换过程中发生了更改。未保存最终输出文件；请重新添加文件。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:360
msgid "Conversion cancelled. No incomplete output was published."
msgstr "转换已取消。未保存任何未完成的输出文件。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:374
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "无法访问文件或目标位置。请检查权限和磁盘可用空间。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:383
msgid "The media information or conversion settings are invalid."
msgstr "媒体信息或转换设置无效。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:400
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "编码器更改了请求的采样率。未保存最终输出文件。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:408
msgid "The encoder changed the requested channel count. No output was published."
msgstr "编码器更改了请求的声道数。未保存最终输出文件。"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:416
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "此 FFmpeg 构建版本无法保留所需的 FLAC 精度。请选择 WAV 或安装兼容的 FFmpeg 软件包。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:153
#: usr/share/biglinux/audio-converter/app/audio/converter.py:436
msgid "Select a supported output format."
msgstr "请选择受支持的输出格式。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "请选择有效的本地媒体文件。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "源文件不存在，或不是普通文件。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:38
msgid "The selected audio track is invalid. Add the file again."
msgstr "所选音轨无效。请重新添加文件。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "源视频不存在。请重新添加文件。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:65
msgid "A segment has invalid start or end times."
msgstr "某个片段的开始或结束时间无效。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:69
msgid "Every segment must have a finite end time after its start."
msgstr "每个片段的结束时间必须是有限数值，且晚于开始时间。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:78
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "某个片段超出了源音频的范围。请调整其结束时间。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:85
msgid "A segment must contain at least one audio sample."
msgstr "每个片段必须至少包含一个音频采样点。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:167
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr "未安装 FFprobe。请安装 FFmpeg 软件包后重试。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:194
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr "无法读取媒体文件。文件可能已损坏或不受支持。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:203
msgid "FFprobe returned invalid media information."
msgstr "FFprobe 返回了无效的媒体信息。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:208
msgid "FFprobe returned incomplete media information."
msgstr "FFprobe 返回了不完整的媒体信息。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:221
msgid "This file does not contain the selected audio track."
msgstr "此文件不包含所选音轨。"

#: usr/share/biglinux/audio-converter/app/audio/media.py:265
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr "所选 WAV 编码器无法保留此 PCM 精度。"

#: usr/share/biglinux/audio-converter/app/audio/process.py:109
#: usr/share/biglinux/audio-converter/app/audio/process.py:137
msgid "The media command timed out."
msgstr "媒体处理命令超时。"

#: usr/share/biglinux/audio-converter/app/audio/process.py:126
msgid "The media information is too large to process safely."
msgstr "媒体信息过大，无法安全处理。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:31
msgid "There is not enough free disk space. Free some space and try again."
msgstr "磁盘可用空间不足。请释放一些空间后重试。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:38
msgid "The file or destination is not accessible. Check its permissions."
msgstr "无法访问文件或目标位置。请检查其权限。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:45
msgid "The required audio encoder is unavailable. Install a compatible FFmpeg package."
msgstr "所需的音频编码器不可用。请安装兼容的 FFmpeg 软件包。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:52
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "所选的某个音效在当前 FFmpeg 安装中不可用。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:58
msgid "The audio could not be processed. Check the file and selected output settings."
msgstr "无法处理音频。请检查文件和所选的输出设置。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:149
msgid "Effects require re-encoding. Select an audio format instead of Fast Copy."
msgstr "音效需要重新编码。请选择音频格式，而不是快速复制。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:248
msgid "An intermediate segment has an unsafe path."
msgstr "某个中间片段的路径不安全。"

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:330
msgid "The output contains no readable audio. No file was published."
msgstr "输出中没有可读取的音频。未保存最终文件。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:56
msgid "The audio contains non-finite samples."
msgstr "音频包含非有限值的采样点。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:98
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "解码后的音频以不完整的采样帧结束。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:101
msgid "The file contains no readable audio samples."
msgstr "文件中没有可读取的音频采样点。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:247
msgid "FFmpeg is not installed."
msgstr "未安装 FFmpeg。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:300
msgid "The waveform could not be generated."
msgstr "无法生成波形。"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:318
msgid "The source changed while its waveform was being generated."
msgstr "生成波形时，源文件发生了更改。"

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:58
msgid "Too many files are waiting for inspection. Wait for some files to finish, then add more."
msgstr "等待分析的文件过多。请等部分文件分析完成后再继续添加。"

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:79
msgid "Select a regular local media file, not a folder or device."
msgstr "请选择普通的本地媒体文件，而不是文件夹或设备。"

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:100
msgid "The file changed during inspection. Add it again."
msgstr "文件在分析过程中发生了更改。请重新添加。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:152
msgid "Audio preview is unavailable. Install mpv and python-mpv, then reopen the application."
msgstr "音频试听不可用。请安装 mpv 和 python-mpv，然后重新打开应用程序。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:179
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr "无法列出音频输出。请尝试重新打开输出选择器。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:201
msgid "The selected audio output was disconnected. Playback is paused. Choose an output or resume using the system default."
msgstr "所选音频输出已断开连接。播放已暂停。请选择输出，或使用系统默认输出继续播放。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:214
msgid "This audio output is no longer available. Choose another output."
msgstr "此音频输出已不可用。请选择其他输出。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:226
msgid "The audio output could not be selected. Choose another output."
msgstr "无法选择音频输出。请选择其他输出。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:252
msgid "The selected audio track is unavailable. Add the file again."
msgstr "所选音轨不可用。请重新添加文件。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:284
msgid "The audio could not be played. Check the file and audio output device."
msgstr "无法播放音频。请检查文件和音频输出设备。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:411
msgid "This audio position could not be reached."
msgstr "无法跳转到此音频位置。"

#: usr/share/biglinux/audio-converter/app/audio/player.py:459
msgid "A preview effect could not be applied. Check the selected effects and installed plugins."
msgstr "无法应用某个试听音效。请检查所选音效和已安装的插件。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:111
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "{key} 的值无效。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:115
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "{key} 必须介于 {low} 和 {high} 之间。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:123
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "{key} 的开关值无效。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:133
msgid "The equalizer bands are invalid."
msgstr "均衡器频段无效。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:139
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "均衡器需要十个介于 -40 和 40 dB 之间的有限增益值。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:144
msgid "Select a supported noise reduction mode."
msgstr "请选择受支持的降噪模式。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:168
msgid "FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow conversion to 24-bit PCM in Advanced encoding."
msgstr "FLAC 无法保留此 PCM 表示方式。请选择 WAV，或在“高级编码”中明确允许转换为 24 位 PCM。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:193
msgid "The selected bitrate is not supported by this output profile."
msgstr "此输出配置不支持所选比特率。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:201
msgid "Select original, mono or stereo channels."
msgstr "请选择原始声道、单声道或立体声。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:208
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "MP3 支持单声道或立体声。请选择立体声或其他格式。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:216
msgid "Select a valid output sample rate."
msgstr "请选择有效的输出采样率。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:222
msgid "The selected codec does not support that sample rate."
msgstr "所选编解码器不支持该采样率。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:289
msgid "The selected noise reduction plugin is unavailable. Install it or turn noise reduction off."
msgstr "所选降噪插件不可用。请安装该插件或关闭降噪。"

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:319
msgid "The audio plugin path is unsupported."
msgstr "音频插件路径不受支持。"

