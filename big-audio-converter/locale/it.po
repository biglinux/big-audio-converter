msgstr "Non riuscito"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:160
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:220
msgid "Cancelled"
msgstr "Annullato"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:180
msgid "Conversion Results"
msgstr "Risultati della conversione"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:193
#, python-brace-format
msgid "Converted: {success} · Failed: {failed} · Cancelled: {cancelled}"
msgstr "Convertiti: {success} · Non riusciti: {failed} · Annullati: {cancelled}"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:199
msgid "Existing files were not replaced. Inputs remain in the queue."
msgstr "I file esistenti non sono stati sostituiti. I file di origine rimangono nella coda."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:240
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:243
msgid "Show output file"
msgstr "Mostra file di uscita"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:252
msgid "Technical details"
msgstr "Dettagli tecnici"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:264
msgid "Retry unfinished files"
msgstr "Riprova i file non completati"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:269
msgid "Close"
msgstr "Chiudi"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:290
msgid "Folder could not be opened"
msgstr "Impossibile aprire la cartella"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:291
#, python-brace-format
msgid "Open your file manager and navigate to: {path}"
msgstr "Apri il gestore di file e vai a: {path}"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:98
msgid "Default Voice"
msgstr "Voce predefinita"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:102
msgid "Natural (No Effects)"
msgstr "Naturale (senza effetti)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:106
msgid "Crystal Voice"
msgstr "Voce cristallina"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:110
msgid "Radio Host"
msgstr "Voce da speaker radiofonico"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:114
msgid "Velvet Voice"
msgstr "Voce vellutata"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:118
msgid "Extra Brightness"
msgstr "Brillantezza aggiuntiva"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:122
msgid "Soften 'S' (De-esser)"
msgstr "Attenua le «s» (de-esser)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:126
msgid "Remove Rumble"
msgstr "Rimuovi i rimbombi"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:130
msgid "Present Voice"
msgstr "Voce più presente"

