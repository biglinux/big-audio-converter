#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:45
msgid "Default Voice"
msgstr "Standardstemme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:49
msgid "Natural (No Effects)"
msgstr "Naturlig (uten effekter)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:53
msgid "Crystal Voice"
msgstr "Krystallklar stemme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:57
msgid "Radio Host"
msgstr "Radiostemme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:61
msgid "Velvet Voice"
msgstr "Fløyelsmyk stemme"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:65
msgid "Extra Brightness"
msgstr "Ekstra klarhet"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:69
msgid "Soften 'S' (De-esser)"
msgstr "Demp s-lyder (de-esser)"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:73
msgid "Remove Rumble"
msgstr "Fjern romling"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:77
msgid "Present Voice"
msgstr "Mer nærvær i stemmen"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:80
msgid "Custom"
msgstr "Egendefinert"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:122 usr/share/biglinux/audio-converter/app/ui/main_window.py:470 usr/share/biglinux/audio-converter/app/ui/main_window.py:475
msgid "Equalizer"
msgstr "Equalizer"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:136
msgid "Equalizer preset"
msgstr "Equalizerforvalg"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:149
msgid "Close equalizer"
msgstr "Lukk equalizer"

#: usr/share/biglinux/audio-converter/app/ui/equalizer_panel.py:188
#, python-brace-format
msgid "Equalizer band {} Hz"
msgstr "Equalizerbånd på {} Hz"

#: usr/share/biglinux/audio-converter/app/ui/file_info.py:110
msgid "Size"
msgstr "Størrelse"

