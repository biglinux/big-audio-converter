#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:346
msgid "Adjust sound"
msgstr "Juster lyden"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:351
msgid "Even volume"
msgstr "Jevn lydstyrke"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:352
msgid "Brings every file to the same loudness (−16 LUFS)"
msgstr "Gir alle filer samme lydstyrke (−16 LUFS)"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:361
msgid "Silence pauses"
msgstr "Demp pauser"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:362
msgid "Mutes the background between words"
msgstr "Demper bakgrunnslyden mellom ordene"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:369
msgid "Balance loud and quiet parts"
msgstr "Balanser sterke og svake partier"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:370
