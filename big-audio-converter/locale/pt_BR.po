msgstr "Baixe este arquivo para uma pasta local antes de adicioná-lo."

#: usr/share/biglinux/audio-converter/main.py:201
#: usr/share/biglinux/audio-converter/main.py:203
msgid "BigLinux Team"
msgstr "Equipe BigLinux"

