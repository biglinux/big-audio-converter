msgid "Try Again"
msgstr "Tentar novamente"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:142
#, python-brace-format
msgid "{count} file converted"
msgid_plural "{count} files converted"
msgstr[0] "{count} arquivo convertido"
