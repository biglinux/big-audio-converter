msgstr "Cancelando…"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:101
#, python-brace-format
msgid "Converting {current} of {total} · {percent}%"
msgstr "Convertendo {current} de {total} · {percent}%"

