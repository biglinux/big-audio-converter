#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:19
msgid "Welcome"
msgstr "Vítejte"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:33
msgid "Convert audio in three steps"
msgstr "Převod zvuku ve třech krocích"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:39
msgid "1. Add your files"
msgstr "1. Přidejte soubory"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:40
msgid "Add audio or video files. Videos with several audio tracks show one entry for each track."
msgstr "Přidejte zvukové soubory nebo videa. U videí s více zvukovými stopami se každá stopa zobrazí jako samostatná položka."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:45
msgid "2. Choose the output"
msgstr "2. Vyberte výstup"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:46
msgid "Choose MP3, FLAC, Ogg Vorbis, WAV, AAC or Opus and a destination folder. Original files are never replaced."
msgstr "Vyberte formát MP3, FLAC, Ogg Vorbis, WAV, AAC nebo Opus a cílovou složku. Původní soubory se nikdy nenahrazují."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:51
msgid "3. Convert"
msgstr "3. Spusťte převod"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:52
msgid "The results list each output and any files that need another attempt. Your queue stays available for repeating an operation."
msgstr "Ve výsledcích se zobrazí všechny výstupy i soubory, u kterých je třeba převod zopakovat. Fronta zůstává k dispozici pro opakování operace."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:57
msgid "Editing and effects"
msgstr "Úpravy a efekty"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:58
msgid "Edit Segments provides start and end times and keyboard controls. Volume, speed, equalizer and other enabled effects also change exported audio."
msgstr "Editor úseků nabízí zadání začátku a konce i ovládání klávesnicí. Hlasitost, rychlost, ekvalizér a další povolené efekty mění také exportovaný zvuk."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:63
msgid "Fast Copy"
msgstr "Rychlé kopírování"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:64
msgid "Copy encoded audio without re-encoding. Cut boundaries are approximate; effects are bypassed. Container support determines which tags and artwork can be kept."
msgstr "Kopíruje kódovaný zvuk bez opětovného kódování. Hranice střihů jsou přibližné a efekty se nepoužívají. Podpora kontejneru určuje, které značky a přebaly lze zachovat."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:69
msgid "Speech cleanup"
msgstr "Vyčištění řeči"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:70
msgid "Neural noise reduction requires the optional DeepFilterNet3 or DPDFNet-2 plugin and is intended for speech, not music. Unavailable effects are identified in settings."
msgstr "Neuronové potlačení šumu vyžaduje volitelný modul DeepFilterNet3 nebo DPDFNet-2 a je určeno pro řeč, nikoli pro hudbu. Nedostupné efekty jsou označeny v nastavení."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:82
msgid "Show dialog on startup"
msgstr "Zobrazovat dialog při spuštění"

