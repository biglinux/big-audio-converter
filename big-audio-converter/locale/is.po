#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:39
msgid "1. Add your files"
msgstr "1. Bættu við skrám"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:40
msgid "Add audio or video files. Videos with several audio tracks show one entry for each track."
msgstr "Bættu við hljóð- eða myndskeiðsskrám. Myndskeið með mörgum hljóðrásum fá eina færslu fyrir hverja rás."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:45
msgid "2. Choose the output"
msgstr "2. Veldu úttak"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:46
msgid "Choose MP3, FLAC, Ogg Vorbis, WAV, AAC or Opus and a destination folder. Original files are never replaced."
msgstr "Veldu MP3, FLAC, Ogg Vorbis, WAV, AAC eða Opus og áfangamöppu. Aldrei er skrifað yfir frumskrárnar."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:51
msgid "3. Convert"
msgstr "3. Umbreyttu"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:52
msgid "The results list each output and any files that need another attempt. Your queue stays available for repeating an operation."
msgstr "Niðurstöðurnar sýna hverja úttaksskrá og þær skrár sem þarf að reyna aftur. Biðröðin er áfram tiltæk til að endurtaka aðgerð."

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:57
msgid "Editing and effects"
msgstr "Breytingar og áhrif"

#: usr/share/biglinux/audio-converter/app/ui/welcome_dialog.py:58
msgid "Edit Segments provides start and end times and keyboard controls. Volume, speed, equalizer and other enabled effects also change exported audio."
msgstr "Breyta bútum býður upp á reiti fyrir upphafs- og lokatíma og lyklaborðsstýringu. Hljóðstyrkur, hraði, tónjafnari og önnur virk áhrif breyta einnig útfluttu hljóði."

