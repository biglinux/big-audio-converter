msgstr "Zachovať pôvodné vlastnosti, ak sú podporované"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:421
msgid "Mono"
msgstr "Mono"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:421
msgid "Stereo"
msgstr "Stereo"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:439
msgid "Allow conversion to 24-bit PCM"
msgstr "Povoliť konverziu na 24-bitové PCM"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:441
msgid "For floating-point audio exported to FLAC. Reduces precision; WAV preserves the original representation."
msgstr "Pre zvuk s pohyblivou rádovou čiarkou exportovaný do FLAC. Znižuje presnosť; WAV zachováva pôvodnú reprezentáciu."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:458
msgid "Fast Copy keeps encoded audio. Cuts follow packet boundaries and may not match the exact times. Effects are bypassed in preview and export."
msgstr "Rýchle kopírovanie zachováva kódovaný zvuk. Strihy sledujú hranice paketov a nemusia zodpovedať presným časom. Efekty sa nepoužívajú pri náhľadovom prehrávaní ani pri exporte."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:469
msgid "Boosting volume or equalizer bands can distort audio. Reduce gain or enable clipping protection."
msgstr "Zvýšenie hlasitosti alebo zosilnenie pásiem ekvalizéra môže zvuk skresliť. Znížte zosilnenie alebo zapnite ochranu pred prebudením signálu."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:498
msgid "Local folder required"
msgstr "Vyžaduje sa miestny priečinok"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:499
msgid "Choose a folder on the local filesystem."
msgstr "Vyberte priečinok v miestnom súborovom systéme."

