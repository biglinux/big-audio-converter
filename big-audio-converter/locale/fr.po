msgstr "Empêche l’écrêtage des pics forts"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:485
msgid "Advanced encoding"
msgstr "Encodage avancé"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:486
