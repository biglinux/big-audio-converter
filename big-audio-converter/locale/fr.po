msgstr "Volume {percent} %"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:857
#, python-brace-format
msgid "Speed {factor}×"
msgstr "Vitesse {factor}×"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:874
msgid "Volume, speed, equalizer and effects"
msgstr "Volume, vitesse, égaliseur et effets"

