msgstr "Conserver les propriétés d’origine si elles sont prises en charge"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:490
msgid "Mono"
msgstr "Mono"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:490
msgid "Stereo"
msgstr "Stéréo"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:508
msgid "Allow conversion to 24-bit PCM"
msgstr "Autoriser la conversion en PCM 24 bits"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:510
msgid "For floating-point audio exported to FLAC. Reduces precision; WAV preserves the original representation."
msgstr "Pour le son en virgule flottante exporté en FLAC. Réduit la précision ; WAV préserve la représentation d’origine."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:527
msgid "Fast Copy keeps encoded audio. Cuts follow packet boundaries and may not match the exact times. Effects are bypassed in preview and export."
msgstr "La copie directe conserve le son encodé. Les coupes suivent les limites des paquets et peuvent ne pas correspondre aux temps exacts. Les effets sont ignorés à la préécoute comme à l’exportation."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:538
msgid "Boosting volume or equalizer bands can distort audio. Reduce gain or enable clipping protection."
msgstr "Augmenter le volume ou le gain des bandes de l’égaliseur peut déformer le son. Réduisez le gain ou activez la protection contre l’écrêtage."

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:648
msgid "Local folder required"
msgstr "Dossier local requis"

#: usr/share/biglinux/audio-converter/app/ui/settings_mixin.py:649
msgid "Choose a folder on the local filesystem."
msgstr "Choisissez un dossier du système de fichiers local."

