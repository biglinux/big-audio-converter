#: usr/share/biglinux/audio-converter/main.py:86
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1325
msgid "Local files only"
msgstr "Fichiers locaux uniquement"

#: usr/share/biglinux/audio-converter/main.py:87
msgid "Download this file to a local folder before adding it."
msgstr "Téléchargez ce fichier dans un dossier local avant de l’ajouter."

#: usr/share/biglinux/audio-converter/main.py:191
#: usr/share/biglinux/audio-converter/main.py:215
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:213
msgid "Audio Converter"
msgstr "Convertisseur audio"

#: usr/share/biglinux/audio-converter/main.py:193
#: usr/share/biglinux/audio-converter/main.py:195
msgid "BigLinux Team"
msgstr "Équipe BigLinux"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:62
msgid "The application is closing."
msgstr "L’application se ferme."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:66
msgid "A conversion is still running. Wait for it to finish cancelling before starting another."
msgstr "Une conversion est encore en cours. Attendez la fin de son annulation avant d’en lancer une autre."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:120
msgid "Conversion cancelled."
msgstr "Conversion annulée."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:142
msgid "The output path is invalid. Check the source filename and destination."
msgstr "Le chemin de sortie est invalide. Vérifiez le nom du fichier source et la destination."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:171
#, python-brace-format
msgid "Joined into {name}"
msgstr "Fusionné dans {name}"

#: usr/share/biglinux/audio-converter/app/audio/converter.py:186
msgid "An unexpected error stopped this conversion."
msgstr "Une erreur inattendue a interrompu cette conversion."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:228
msgid "The length of this file is unknown, so marked parts cannot be removed. Keep them instead."
msgstr "La durée de ce fichier est inconnue, les parties marquées ne peuvent donc pas être retirées. Choisissez plutôt « Les garder »."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:240
msgid "Every part of this file is marked for removal."
msgstr "Toutes les parties de ce fichier sont marquées pour être retirées."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:256
msgid "FFmpeg is not installed. Install the FFmpeg package and try again."
msgstr "FFmpeg n’est pas installé. Installez le paquet FFmpeg et réessayez."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:271
msgid "Fast Copy cannot join files. Select an audio format."
msgstr "La copie directe ne permet pas de fusionner des fichiers. Sélectionnez un format audio."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:281
msgid "Files with more than two channels can only be joined as mono or stereo. Choose the channels in Advanced encoding."
msgstr "Les fichiers de plus de deux canaux ne peuvent être fusionnés qu’en mono ou en stéréo. Choisissez les canaux dans Encodage avancé."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:304
msgid "Fast Copy cannot apply effects, change channels or resample. Select an encoding format."
msgstr "La copie directe ne permet pas d’appliquer des effets, de changer les canaux ou de rééchantillonner. Sélectionnez un format d’encodage."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:315
msgid "Fast Copy preserves encoded audio packets; cut boundaries are approximate. Effects are not applied."
msgstr "La copie directe préserve les paquets audio encodés ; les limites de coupe sont approximatives. Aucun effet n’est appliqué."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:334
msgid "Floating-point audio was explicitly converted to 24-bit integer PCM for FLAC; this is not a bit-exact copy."
msgstr "Le son en virgule flottante a été converti en PCM entier 24 bits pour FLAC, conformément à votre choix ; il ne s’agit pas d’une copie exacte bit à bit."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:340
msgid "Opus uses a 48 kHz playback sample clock. The source sample rate cannot be represented unchanged in the output container."
msgstr "Opus utilise une fréquence d’échantillonnage de lecture de 48 kHz. La fréquence source ne peut pas être représentée telle quelle dans le conteneur de sortie."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:347
#, python-brace-format
msgid "The output codec requires resampling from {rate} Hz to {final_rate} Hz."
msgstr "Le codec de sortie nécessite un rééchantillonnage de {rate} Hz à {final_rate} Hz."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:362
msgid "Positive gain may clip. Enable clipping protection or reduce the gain."
msgstr "Un gain positif peut provoquer un écrêtage. Activez la protection contre l’écrêtage ou réduisez le gain."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:368
msgid "This raw audio format cannot preserve all tags or artwork."
msgstr "Ce format audio brut ne peut pas conserver toutes les étiquettes ou pochettes."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:375
msgid "Artwork is not preserved by this output profile."
msgstr "Ce profil de sortie ne conserve pas les pochettes."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:443
msgid "The source changed during conversion. No output was published; add the file again."
msgstr "Le fichier source a changé pendant la conversion. Aucun résultat n’a été enregistré ; ajoutez à nouveau le fichier."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:461
msgid "Conversion cancelled. No incomplete output was published."
msgstr "Conversion annulée. Aucun fichier de sortie incomplet n’a été enregistré."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:475
msgid "The file or destination could not be accessed. Check permissions and free disk space."
msgstr "Impossible d’accéder au fichier ou à la destination. Vérifiez les permissions et l’espace disque disponible."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:484
msgid "The media information or conversion settings are invalid."
msgstr "Les informations multimédias ou les paramètres de conversion sont invalides."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:501
msgid "The encoder changed the requested sample rate. No output was published."
msgstr "L’encodeur a modifié la fréquence d’échantillonnage demandée. Aucun résultat n’a été enregistré."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:509
msgid "The encoder changed the requested channel count. No output was published."
msgstr "L’encodeur a modifié le nombre de canaux demandé. Aucun résultat n’a été enregistré."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:517
msgid "This FFmpeg build cannot preserve the requested FLAC precision. Choose WAV or install a compatible FFmpeg package."
msgstr "Cette version de FFmpeg ne peut pas préserver la précision FLAC demandée. Choisissez WAV ou installez un paquet FFmpeg compatible."

#: usr/share/biglinux/audio-converter/app/audio/converter.py:538
#: usr/share/biglinux/audio-converter/app/audio/profiles.py:172
msgid "Select a supported output format."
msgstr "Sélectionnez un format de sortie pris en charge."

#: usr/share/biglinux/audio-converter/app/audio/media.py:24
msgid "Select a valid local media file."
msgstr "Sélectionnez un fichier multimédia local valide."

#: usr/share/biglinux/audio-converter/app/audio/media.py:32
msgid "The source file is missing or is not a regular file."
msgstr "Le fichier source est introuvable ou n’est pas un fichier ordinaire."

#: usr/share/biglinux/audio-converter/app/audio/media.py:39
msgid "The selected audio track is invalid. Add the file again."
msgstr "La piste audio sélectionnée est invalide. Ajoutez à nouveau le fichier."

#: usr/share/biglinux/audio-converter/app/audio/media.py:44
msgid "The source video is missing. Add the file again."
msgstr "La vidéo source est introuvable. Ajoutez à nouveau le fichier."

#: usr/share/biglinux/audio-converter/app/audio/media.py:77
msgid "A segment has invalid start or end times."
msgstr "Un segment a un temps de début ou de fin invalide."

#: usr/share/biglinux/audio-converter/app/audio/media.py:82
msgid "Every segment must have a finite end time after its start."
msgstr "Chaque segment doit avoir un temps de fin fini et postérieur à son début."

#: usr/share/biglinux/audio-converter/app/audio/media.py:91
msgid "A segment extends beyond the source audio. Adjust its end time."
msgstr "Un segment dépasse la durée du son source. Ajustez son temps de fin."

#: usr/share/biglinux/audio-converter/app/audio/media.py:97
msgid "A segment must contain at least one audio sample."
msgstr "Un segment doit contenir au moins un échantillon audio."

#: usr/share/biglinux/audio-converter/app/audio/media.py:183
msgid "FFprobe is not installed. Install the FFmpeg package and try again."
msgstr "FFprobe n’est pas installé. Installez le paquet FFmpeg et réessayez."

#: usr/share/biglinux/audio-converter/app/audio/media.py:210
msgid "The media file could not be read. It may be damaged or unsupported."
msgstr "Impossible de lire le fichier multimédia. Il est peut-être endommagé ou non pris en charge."

#: usr/share/biglinux/audio-converter/app/audio/media.py:218
msgid "FFprobe returned invalid media information."
msgstr "FFprobe a renvoyé des informations multimédias invalides."

#: usr/share/biglinux/audio-converter/app/audio/media.py:223
msgid "FFprobe returned incomplete media information."
msgstr "FFprobe a renvoyé des informations multimédias incomplètes."

#: usr/share/biglinux/audio-converter/app/audio/media.py:236
msgid "This file does not contain the selected audio track."
msgstr "Ce fichier ne contient pas la piste audio sélectionnée."

#: usr/share/biglinux/audio-converter/app/audio/media.py:281
msgid "This PCM precision cannot be preserved by the selected WAV encoder."
msgstr "L’encodeur WAV sélectionné ne peut pas préserver cette précision PCM."

#: usr/share/biglinux/audio-converter/app/audio/player.py:157
msgid "Audio preview is unavailable. Install mpv and python-mpv, then reopen the application."
msgstr "La préécoute audio est indisponible. Installez mpv et python-mpv, puis rouvrez l’application."

#: usr/share/biglinux/audio-converter/app/audio/player.py:184
msgid "Audio outputs could not be listed. Try reopening the output selector."
msgstr "Impossible de lister les sorties audio. Essayez de rouvrir le sélecteur de sortie."

#: usr/share/biglinux/audio-converter/app/audio/player.py:206
msgid "The selected audio output was disconnected. Playback is paused. Choose an output or resume using the system default."
msgstr "La sortie audio sélectionnée a été déconnectée. La lecture est en pause. Choisissez une sortie ou reprenez avec celle par défaut du système."

#: usr/share/biglinux/audio-converter/app/audio/player.py:219
msgid "This audio output is no longer available. Choose another output."
msgstr "Cette sortie audio n’est plus disponible. Choisissez-en une autre."

#: usr/share/biglinux/audio-converter/app/audio/player.py:231
msgid "The audio output could not be selected. Choose another output."
msgstr "Impossible de sélectionner la sortie audio. Choisissez-en une autre."

#: usr/share/biglinux/audio-converter/app/audio/player.py:257
msgid "The selected audio track is unavailable. Add the file again."
msgstr "La piste audio sélectionnée est indisponible. Ajoutez à nouveau le fichier."

#: usr/share/biglinux/audio-converter/app/audio/player.py:289
msgid "The audio could not be played. Check the file and audio output device."
msgstr "Impossible de lire le son. Vérifiez le fichier et le périphérique de sortie audio."

#: usr/share/biglinux/audio-converter/app/audio/player.py:415
msgid "This audio position could not be reached."
msgstr "Impossible d’atteindre cette position dans le son."

#: usr/share/biglinux/audio-converter/app/audio/player.py:467
msgid "A preview effect could not be applied. Check the selected effects and installed plugins."
msgstr "Impossible d’appliquer un effet à la préécoute. Vérifiez les effets sélectionnés et les greffons installés."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:59
msgid "Too many files are waiting for inspection. Wait for some files to finish, then add more."
msgstr "Trop de fichiers sont en attente d’analyse. Attendez que l’analyse de certains se termine avant d’en ajouter d’autres."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:80
msgid "Select a regular local media file, not a folder or device."
msgstr "Sélectionnez un fichier multimédia local ordinaire, et non un dossier ou un périphérique."

#: usr/share/biglinux/audio-converter/app/audio/probe_service.py:100
msgid "The file changed during inspection. Add it again."
msgstr "Le fichier a changé pendant l’analyse. Ajoutez-le à nouveau."

#: usr/share/biglinux/audio-converter/app/audio/process.py:116
#: usr/share/biglinux/audio-converter/app/audio/process.py:144
msgid "The media command timed out."
msgstr "L’opération multimédia a dépassé le délai imparti."

#: usr/share/biglinux/audio-converter/app/audio/process.py:134
msgid "The media information is too large to process safely."
msgstr "Les informations multimédias sont trop volumineuses pour être traitées en toute sécurité."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:130
#, python-brace-format
msgid "Invalid value for {key}."
msgstr "Valeur invalide pour {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:134
#, python-brace-format
msgid "{key} must be between {low} and {high}."
msgstr "{key} doit être compris entre {low} et {high}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:142
#, python-brace-format
msgid "Invalid switch value for {key}."
msgstr "Valeur d’activation invalide pour {key}."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:152
msgid "The equalizer bands are invalid."
msgstr "Les bandes de l’égaliseur sont invalides."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:159
msgid "The equalizer needs ten finite gains between -40 and 40 dB."
msgstr "L’égaliseur nécessite dix gains finis compris entre -40 et 40 dB."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:163
msgid "Select a supported noise reduction mode."
msgstr "Sélectionnez un mode de réduction de bruit pris en charge."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:188
msgid "FLAC cannot preserve this PCM representation. Choose WAV or explicitly allow conversion to 24-bit PCM in Advanced encoding."
msgstr "FLAC ne peut pas préserver cette représentation PCM. Choisissez WAV ou autorisez explicitement la conversion en PCM 24 bits dans Encodage avancé."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:213
msgid "The selected bitrate is not supported by this output profile."
msgstr "Le débit binaire sélectionné n’est pas pris en charge par ce profil de sortie."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:220
msgid "Select original, mono or stereo channels."
msgstr "Sélectionnez les canaux d’origine, mono ou stéréo."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:228
msgid "MP3 supports mono or stereo. Select stereo channels or another format."
msgstr "MP3 prend en charge le mono ou la stéréo. Sélectionnez des canaux stéréo ou un autre format."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:235
msgid "Select a valid output sample rate."
msgstr "Sélectionnez une fréquence d’échantillonnage de sortie valide."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:242
msgid "The selected codec does not support that sample rate."
msgstr "Le codec sélectionné ne prend pas en charge cette fréquence d’échantillonnage."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:316
msgid "The selected noise reduction plugin is unavailable. Install it or turn noise reduction off."
msgstr "Le greffon de réduction de bruit sélectionné est indisponible. Installez-le ou désactivez la réduction de bruit."

#: usr/share/biglinux/audio-converter/app/audio/profiles.py:350
msgid "The audio plugin path is unsupported."
msgstr "Le chemin du greffon audio n’est pas pris en charge."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:40
msgid "There is not enough free disk space. Free some space and try again."
msgstr "L’espace disque disponible est insuffisant. Libérez de l’espace et réessayez."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:47
msgid "The file or destination is not accessible. Check its permissions."
msgstr "Le fichier ou la destination est inaccessible. Vérifiez les permissions."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:54
msgid "The required audio encoder is unavailable. Install a compatible FFmpeg package."
msgstr "L’encodeur audio requis est indisponible. Installez un paquet FFmpeg compatible."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:61
msgid "A selected audio effect is unavailable in this FFmpeg installation."
msgstr "Un effet audio sélectionné est indisponible dans cette installation de FFmpeg."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:67
msgid "The audio could not be processed. Check the file and selected output settings."
msgstr "Impossible de traiter le son. Vérifiez le fichier et les paramètres de sortie sélectionnés."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:164
msgid "Effects require re-encoding. Select an audio format instead of Fast Copy."
msgstr "Les effets nécessitent un réencodage. Sélectionnez un format audio plutôt que Copie directe."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:320
msgid "An intermediate segment has an unsafe path."
msgstr "Un segment intermédiaire utilise un chemin non sécurisé."

#: usr/share/biglinux/audio-converter/app/audio/segment_processor.py:403
msgid "The output contains no readable audio. No file was published."
msgstr "Le résultat ne contient aucun son lisible. Aucun fichier n’a été enregistré."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:56
msgid "The audio contains non-finite samples."
msgstr "Le son contient des échantillons aux valeurs non finies."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:98
msgid "The decoded audio ends with an incomplete sample frame."
msgstr "Le son décodé se termine par une trame d’échantillons incomplète."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:101
msgid "The file contains no readable audio samples."
msgstr "Le fichier ne contient aucun échantillon audio lisible."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:233
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:164
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:202
#: usr/share/biglinux/audio-converter/app/ui/visualizer.py:1319
msgid "Generating waveform..."
msgstr "Génération de la forme d’onde…"

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:241
msgid "FFmpeg is not installed."
msgstr "FFmpeg n’est pas installé."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:292
msgid "The waveform could not be generated."
msgstr "Impossible de générer la forme d’onde."

#: usr/share/biglinux/audio-converter/app/audio/waveform.py:311
msgid "The source changed while its waveform was being generated."
msgstr "Le fichier source a changé pendant la génération de sa forme d’onde."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:37
msgid "Inspecting audio"
msgstr "Analyse du son"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:39
msgid "Files are still being inspected. Conversion will be available when inspection finishes."
msgstr "L’analyse des fichiers est toujours en cours. La conversion sera disponible une fois l’analyse terminée."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:46
msgid "No files to convert"
msgstr "Aucun fichier à convertir"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:46
msgid "Please add at least one file to convert."
msgstr "Ajoutez au moins un fichier à convertir."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:57
msgid "Check conversion settings"
msgstr "Vérifiez les paramètres de conversion"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:63
msgid "Converting Files"
msgstr "Conversion des fichiers"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:77
msgid "Preparing conversion…"
msgstr "Préparation de la conversion…"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:80
msgid "Overall conversion progress"
msgstr "Progression globale de la conversion"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:82
#: usr/share/biglinux/audio-converter/app/ui/file_queue.py:894
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1181
#: usr/share/biglinux/audio-converter/app/ui/main_window.py:1200
#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:175
#: usr/share/biglinux/audio-converter/app/ui/marker_manager.py:223
msgid "Cancel"
msgstr "Annuler"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:100
msgid "Conversion could not start"
msgstr "Impossible de démarrer la conversion"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:107
msgid "Cancelling…"
msgstr "Annulation…"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:109
msgid "Stopping the current operation and removing incomplete outputs…"
msgstr "Arrêt de l’opération en cours et suppression des fichiers de sortie incomplets…"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:127
#, python-brace-format
msgid ""
"File {current} of {total}\n"
"{name}"
msgstr ""
"Fichier {current} sur {total}\n"
"{name}"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:158
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:218
msgid "Converted"
msgstr "Converti"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:159
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:219
msgid "Failed"
msgstr "Échec"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:160
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:220
msgid "Cancelled"
msgstr "Annulé"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:180
msgid "Conversion Results"
msgstr "Résultats de la conversion"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:193
#, python-brace-format
msgid "Converted: {success} · Failed: {failed} · Cancelled: {cancelled}"
msgstr "Convertis : {success} · Échecs : {failed} · Annulés : {cancelled}"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:199
msgid "Existing files were not replaced. Inputs remain in the queue."
msgstr "Les fichiers existants n’ont pas été remplacés. Les fichiers sources restent dans la file."

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:240
#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:243
msgid "Show output file"
msgstr "Afficher le fichier de sortie"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:252
msgid "Technical details"
msgstr "Détails techniques"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:264
msgid "Retry unfinished files"
msgstr "Réessayer les fichiers non terminés"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:269
msgid "Close"
msgstr "Fermer"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:290
msgid "Folder could not be opened"
msgstr "Impossible d’ouvrir le dossier"

#: usr/share/biglinux/audio-converter/app/ui/conversion_controller.py:291
