# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=big-audio-converter
pkgdesc="audio converter and simple editor"
depends=('python>=3.10' 'python-gobject' 'gtk4>=4.12' 'ffmpeg' 'python-cairo' 'python-numpy' 'libadwaita>=1.5' 'python-mpv')
optdepends=('deepfilternet3-native: light speech noise reduction (standard DFN3, without LL)'
    'dpdfnet-native: higher-quality speech noise reduction with DPDFNet-2 48 kHz HR')
makedepends=('git' 'gettext')
checkdepends=('python-pytest' 'python-hypothesis')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-3.0-only')
url="https://github.com/biglinux/$pkgname"
source=("git+${url}.git")
md5sums=('SKIP')

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

build() {
    cd "${srcdir}/${pkgname}" || return
    local catalog language
    for catalog in big-audio-converter/locale/*.po; do
        language=${catalog##*/}
        language=${language%.po}
        mkdir -p "big-audio-converter/usr/share/locale/${language}/LC_MESSAGES"
        msgfmt --check -o "big-audio-converter/usr/share/locale/${language}/LC_MESSAGES/big-audio-converter.mo" "$catalog"
    done
}

check() {
    cd "${srcdir}/${pkgname}" || return
    mkdir -p "${srcdir}/test-tmp"
    TMPDIR="${srcdir}/test-tmp" python -m pytest -q -m "not extended" tests --ignore=tests/test_gui.py
}

package() {
    cd "${srcdir}/${pkgname}" || return

    cp -a big-audio-converter/usr "${pkgdir}/"
    find "${pkgdir}/usr" -type d -name __pycache__ -prune -exec rm -r {} +

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md screenshot.png
}
