# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=big-audio-converter
pkgdesc="audio converter and simple editor"
depends=('python>=3.10' 'python-gobject' 'gtk4>=4.12' 'ffmpeg' 'python-cairo' 'python-numpy' 'libadwaita>=1.5' 'python-mpv')
optdepends=('deepfilternet3-native: light speech noise reduction (standard DFN3, without LL)'
    'dpdfnet-native: higher-quality speech noise reduction with DPDFNet-2 48 kHz HR')
makedepends=('git' 'gettext')
checkdepends=('python-pytest' 'python-hypothesis')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('GPL-3.0-only' 'MIT')
url="https://github.com/biglinux/$pkgname"
# big-gtk-kit's Python module (MIT) ships inside this package, from its main.
_gtk_kit="big-gtk-kit::git+https://github.com/biglinux/big-gtk-kit.git#branch=main"
# Inside a checkout this recipe builds its working tree, uncommitted changes
# included. GitLab's chroot receives only this directory and fetches from
# GitHub instead; keep that line literal, the builder appends #branch= to it.
_recipe_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd -P)
_checkout=${_recipe_dir%/*}
if [ -e "${_checkout}/.git" ] && [ -d "${_checkout}/${pkgname}/usr" ]; then
    source=("${_gtk_kit}")
    md5sums=('SKIP')
else
    _checkout=
    source=("git+${url}.git"
            "${_gtk_kit}")
    md5sums=('SKIP' 'SKIP')
fi

# Automatically detect and use the correct install file
if [ -e "${pkgname}.install" ]; then
    install=${pkgname}.install
elif [ -e "pkgbuild.install" ]; then
    install=pkgbuild.install
fi

prepare() {
    [ -n "${_checkout}" ] || return 0
    # The files git sees: tracked and new ones, without ignored output or this
    # recipe's own src/ and pkg/.
    rm -rf "${srcdir:?}/${pkgname}"
    mkdir "${srcdir}/${pkgname}"
    git -C "${_checkout}" ls-files -z --cached --others --exclude-standard \
        -- ":!:${_recipe_dir#"${_checkout}"/}" |
        tar -C "${_checkout}" --null --files-from=- --ignore-failed-read -cf - |
        tar -C "${srcdir}/${pkgname}" -xf -
}

build() {
    cd "${srcdir}/${pkgname}" || return
    local catalog language
    for catalog in big-audio-converter/locale/*.po; do
        language=${catalog##*/}
        language=${language%.po}
        mkdir -p "big-audio-converter/usr/share/locale/${language}/LC_MESSAGES"
        msgfmt --check -o "big-audio-converter/usr/share/locale/${language}/LC_MESSAGES/big-audio-converter.mo" "$catalog"
    done
}

check() {
    cd "${srcdir}/${pkgname}" || return
    mkdir -p "${srcdir}/test-tmp"
    TMPDIR="${srcdir}/test-tmp" PYTHONPATH="${srcdir}/big-gtk-kit/python" \
        python -m pytest -q -m "not extended" tests --ignore=tests/test_gui.py
}

package() {
    cd "${srcdir}/${pkgname}" || return

    cp -a big-audio-converter/usr "${pkgdir}/"
    # -L: the kit links its stylesheet from the Rust half.
    cp -rL "${srcdir}/big-gtk-kit/python/big_gtk_kit" "${pkgdir}/usr/share/biglinux/audio-converter/"
    find "${pkgdir}/usr" -type d -name __pycache__ -prune -exec rm -r {} +

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${srcdir}/big-gtk-kit/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.big-gtk-kit"
    install -Dm644 -t "${pkgdir}/usr/share/doc/${pkgname}" README.md screenshot.png
}
